# ORYX — example environment. Copy to .env and fill in real values.
# Never commit real credentials.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://oryx:oryx_dev_password@127.0.0.1:5432/oryx_dev?schema=public"

# --- API --------------------------------------------------------------------
API_PORT=3001
API_PREFIX=api
# Access token lifetime in seconds (short-lived).
JWT_ACCESS_TTL=900
# Refresh token lifetime in seconds (30 days).
JWT_REFRESH_TTL=2592000
# Secrets MUST be replaced with long random values (>= 32 chars).
JWT_ACCESS_SECRET="change-me-access-secret-min-32-characters-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-characters-long"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
# Refresh and invitation-acceptance ceilings. A browser with several tabs and
# background widgets legitimately refreshes often; raise if you see 429s.
REFRESH_THROTTLE_LIMIT=120
INVITATION_THROTTLE_LIMIT=20

# --- Session cookies --------------------------------------------------------
# Refresh tokens are delivered in an HttpOnly cookie, never to JavaScript.
# COOKIE_SECURE is derived from NODE_ENV when unset; set it to "true" when TLS
# terminates at a reverse proxy in front of the API.
# COOKIE_SECURE=true
# SameSite policy: "lax" (default), "strict", or "none" (requires Secure).
COOKIE_SAMESITE=lax
# Optional cookie domain, e.g. ".oryx.example" to share across subdomains.
# COOKIE_DOMAIN=.oryx.example
# Grace window (ms) during which a just-rotated refresh token may be presented
# again without being treated as a replay. This absorbs benign concurrent
# refreshes from two tabs or a retried request. Outside the window, replay
# revokes the whole token family. Set to 0 to disable the grace window.
REFRESH_ROTATION_GRACE_MS=30000

# --- Multi-factor authentication --------------------------------------------
# MFA secrets are sealed with AES-256-GCM using this key. It MUST be at least
# 32 characters and MUST come from a secret manager in production. Rotating it
# invalidates existing enrollments.
MFA_ENCRYPTION_KEY="change-me-mfa-encryption-key-min-32-characters"
MFA_ISSUER="ORYX Platform"
# Lifetime of the MFA login challenge token, in seconds.
MFA_CHALLENGE_TTL=300
# When "true", a platform Super Admin that has not enrolled MFA is refused at
# the API boundary. Recommended in production.
MFA_REQUIRE_SUPER_ADMIN=false

# --- Admin frontend ---------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001/api"
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_DEFAULT_THEME=dark

# --- Seed -------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL="superadmin@oryx.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe!Oryx2026"

# --- Customer platform & marketplace (Execution 04) -------------------------
# The customer website and mobile app read the same API and reuse
# NEXT_PUBLIC_API_BASE_URL. Customer sessions use their own HttpOnly refresh
# cookie scoped to /api/v1/customer and their own CSRF cookie; the token
# lifetimes below are shared with the staff plane (JWT_ACCESS_TTL /
# JWT_REFRESH_TTL above). A customer password-reset token expires in 30 minutes.
# A native mobile client that cannot use cookies may post its refresh token in
# the request body instead.

# --- Payments ---------------------------------------------------------------
# Adapters report themselves unconfigured until their credentials are present,
# and an unconfigured online gateway leaves the payment intent unpaid.
# BenefitPay is prepared but NOT operational: supply real merchant credentials
# and verify a sandbox transaction before claiming it works.
BENEFITPAY_MERCHANT_ID=""
BENEFITPAY_API_KEY=""
BENEFITPAY_API_SECRET=""
BENEFITPAY_BASE_URL=""
# Generic online card gateway (e.g. a PSP of the operator's choice).
CARD_GATEWAY_PROVIDER=""
CARD_GATEWAY_API_KEY=""
# Webhook signature secret, one per provider, named <PROVIDER>_WEBHOOK_SECRET
# (for example BENEFITPAY_WEBHOOK_SECRET or CARD_ONLINE_WEBHOOK_SECRET). A
# provider with no configured secret has its webhooks rejected.
BENEFITPAY_WEBHOOK_SECRET="change-me-benefitpay-webhook-secret"

# --- Notification transports ------------------------------------------------
# Each channel transmits nothing until its credentials exist. In-app
# notifications work with no configuration at all. For EMAIL_PROVIDER="smtp",
# SMTP_HOST is what marks the adapter configured.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
SMTP_HOST=""
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""
WHATSAPP_PROVIDER=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
PUSH_PROVIDER=""
PUSH_SERVER_KEY=""
