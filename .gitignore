node_modules/
dist/
build/
.next/
out/
coverage/
*.log
.env
.env.local
.env.*.local
# Production and staging secrets live in a real env file and must never be
# committed. The templates in deploy/env/ are the committed examples.
.env.production
.env.staging
!.env.example
# TLS private keys and certificates are host-specific secrets, never source.
# `deploy/nginx/certs/` holds them at runtime; only the .gitkeep placeholder is
# tracked.
deploy/nginx/certs/*
!deploy/nginx/certs/.gitkeep
.DS_Store
.agent_tmp/
test-results/
playwright-report/
packages/database/prisma/migrations/dev.db*
*.tsbuildinfo
.oryx-tmp/
tsconfig.build.tsbuildinfo

# Local test artifacts
apps/admin/test-results/
apps/admin/playwright-report/
.env.local

# Local staging stack runtime data (.run/start-stack.sh and .run/nginx.conf are tracked)
.run/pgdata/
.run/nginx-tmp/
.run/*.log
.run/*.pid
.run/*.pid.lock
# Scratch renders served locally for inspection; committed evidence lives in docs/audit/
.run/evidence/

# Uploaded CMS media. The bytes are runtime state produced by the media
# library, not source; the curated source photography that seeds it lives in
# apps/customer/public/media/ and is tracked.
.media/
apps/api/.media/
