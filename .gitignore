node_modules/
dist/
build/
.next/
out/
coverage/
*.log
.env
.env.local
.env.*.local
# Production and staging secrets live in a real env file and must never be
# committed. The templates in deploy/env/ are the committed examples.
.env.production
.env.staging
!.env.example
# TLS private keys and certificates are host-specific secrets, never source.
# `deploy/nginx/certs/` holds them at runtime; only the .gitkeep placeholder is
# tracked.
deploy/nginx/certs/*
!deploy/nginx/certs/.gitkeep
.DS_Store
.agent_tmp/
test-results/
playwright-report/
packages/database/prisma/migrations/dev.db*
*.tsbuildinfo
.oryx-tmp/
tsconfig.build.tsbuildinfo

# Generated official documents (PDFs) and uploaded media are runtime data, not
# source. The paths match DOCUMENT_STORAGE_ROOT and MEDIA_ROOT.
apps/api/.documents/
apps/api/.media/
.documents/
.media/

# Local test artifacts
apps/admin/test-results/
apps/admin/playwright-report/
.env.local

# Local staging stack runtime data (.run/start-stack.sh and .run/nginx.conf are tracked)
.run/pgdata/
.run/nginx-tmp/
.run/*.log
.run/*.pid
.run/*.pid.lock
# Live access tokens written by the ad-hoc .run/get-token.mjs helper. The helper
# script is tracked; the token it writes must never be.
.run/*.tok
# Scratch renders served locally for inspection; committed evidence lives in docs/audit/
.run/evidence/

# The owner-supplied design reference (the printed invoice/quotation and the
# five-page inspection report) carries a real customer's name, phone and
# address. It is a local comparison input, never a repository artefact: keep it
# and any render or side-by-side that embeds it out of the public tree.
.run/pdf-compare/
oryx 22*.pdf

# Local QA scratch: ad-hoc Playwright scripts and their throwaway captures. The
# curated evidence that a report cites is copied into docs/audit/.
qa/

# Uploaded CMS media. The bytes are runtime state produced by the media
# library, not source; the curated source photography that seeds it lives in
# apps/customer/public/media/ and is tracked.
.media/
apps/api/.media/
.run/pgsock/

# Local QA account credentials (a live test password; never committed).
.run/qa-customer-creds.txt

# Uploaded document attachments (invoice/receipt supporting files) and the
# OCR trained-data cache. These bytes are runtime state written by the API,
# never source.
storage/
apps/api/storage/

# Per-task comparison scratch. These directories hold renders and side-by-side
# images of the owner-supplied reference documents, which carry a real
# customer's name, phone and address. Like `.run/pdf-compare/` above they are a
# local comparison input, never a repository artefact.
.run/task1/
.run/task2/
.run/preview/
.run/print-compare/
oryx out put*.pdf

# Ad-hoc verification/repro scripts kept out of the release branch.
.run/*.mjs
.run/*.py
.run/*.sh
.run/preview-links/

# Ad-hoc visual-comparison scratch produced while matching the approved
# print references; the PNGs are large and reproducible from the sources.
.run/insp-cmp/
.run/task1final/
