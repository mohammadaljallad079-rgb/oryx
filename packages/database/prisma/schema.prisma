// ORYX — Execution 01 data model.
//
// Hierarchy: Platform -> Company (internal group company OR external SaaS
// tenant) -> Branch. Tenant-owned rows always carry `companyId` so that
// isolation can be enforced in queries, never only in the UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum CompanyType {
  INTERNAL
  SAAS_TENANT
}

enum CompanyStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

enum ModuleStatus {
  AVAILABLE
  PLANNED
}

enum Locale {
  ar
  en
}

enum Theme {
  dark
  light
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CmsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MobilePlatform {
  IOS
  ANDROID
}

enum SupportSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

// ---------------------------------------------------------------- identity

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  fullNameEn     String
  fullNameAr     String
  status         UserStatus @default(INVITED)
  isSuperAdmin   Boolean    @default(false)
  preferredLocale Locale    @default(ar)
  preferredTheme Theme      @default(dark)
  lastLoginAt    DateTime?
  failedLoginCount Int      @default(0)
  lockedUntil    DateTime?
  /** TOTP MFA: secret is stored encrypted at rest, never in plaintext. */
  mfaEnabled     Boolean    @default(false)
  mfaSecretEncrypted String?
  /** Short-lived, single-use enrollment secret pending verification. */
  mfaPendingSecretEncrypted String?
  mfaPendingExpiresAt DateTime?
  /** Monotonic counter that rejects replay of an already-accepted TOTP step. */
  mfaLastUsedStep BigInt?
  mfaEnrolledAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  memberships       Membership[]
  refreshTokens     RefreshToken[]
  invitationsSent   Invitation[]     @relation("InvitationInviter")
  auditLogs         AuditLog[]
  supportSessions   SupportSession[] @relation("SupportSessionActor")
  mfaRecoveryCodes  MfaRecoveryCode[]

  @@index([status])
}

/**
 * Single-use MFA recovery codes. Only a hash of each code is stored, and a
 * code is marked used the first time it is redeemed.
 */
model MfaRecoveryCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  /**
   * Successor token id, written when this token is rotated. Used to detect a
   * benign concurrent refresh (two tabs rotating the same token at once) versus
   * a genuine replay of a long-dead token.
   */
  replacedBy String?
  /**
   * Groups every rotation of one login into a single chain, so revoking a
   * compromised family does not disturb the user's other devices.
   */
  familyId   String    @default(cuid())
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
}

// ---------------------------------------------------------------- organization

model Company {
  id              String        @id @default(cuid())
  code            String        @unique
  nameEn          String
  nameAr          String
  legalNameEn     String?
  type            CompanyType
  status          CompanyStatus @default(PROVISIONING)
  industry        String?
  countryCode     String?
  currency        String        @default("SAR")
  timezone        String        @default("Asia/Riyadh")
  taxNumber       String?
  parentCompanyId String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  parent       Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  children     Company[] @relation("CompanyHierarchy")
  branches     Branch[]
  memberships  Membership[]
  roles        Role[]
  subscriptions Subscription[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  supportSessions SupportSession[]

  // Execution 02 — ERP core (all tenant-owned rows carry companyId).
  documentSequences   DocumentSequence[]
  accounts            Account[]
  fiscalYears         FiscalYear[]
  fiscalPeriods       FiscalPeriod[]
  accountBalances     AccountBalance[]
  journalEntries      JournalEntry[]
  journalLines        JournalLine[]
  payments            Payment[]
  paymentAllocations  PaymentAllocation[]
  customers           Customer[]
  products            Product[]
  warehouses          Warehouse[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  stockTransfers      StockTransfer[]
  stockAdjustments    StockAdjustment[]
  quotations          Quotation[]
  salesOrders         SalesOrder[]
  salesInvoices       SalesInvoice[]
  creditNotes         CreditNote[]
  cashierSessions     CashierSession[]
  posSales            PosSale[]
  suppliers           Supplier[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders      PurchaseOrder[]
  goodsReceipts       GoodsReceipt[]
  supplierInvoices    SupplierInvoice[]
  purchaseReturns     PurchaseReturn[]

  // Execution 03 — HR, CRM, operations and automotive services.
  departments         Department[]
  jobTitles           JobTitle[]
  employees           Employee[]
  employmentContracts EmploymentContract[]
  employeeDocuments   EmployeeDocument[]
  employeeLifecycles  EmployeeLifecycle[]
  leaveTypes          LeaveType[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  shifts              Shift[]
  employeeShifts      EmployeeShift[]
  attendanceRecords   AttendanceRecord[]
  salaryStructures    SalaryStructure[]
  salaryComponents    SalaryComponent[]
  payrollPeriods      PayrollPeriod[]
  payrollRuns         PayrollRun[]
  payslips            Payslip[]
  employeeAdvances    EmployeeAdvance[]
  advanceSettlements  AdvanceSettlement[]

  leadSources         LeadSource[]
  leads               Lead[]
  pipelines           Pipeline[]
  pipelineStages      PipelineStage[]
  opportunities       Opportunity[]
  customerContacts    CustomerContact[]
  crmActivities       CrmActivity[]
  slaPolicies         SlaPolicy[]
  supportTickets      SupportTicket[]
  ticketMessages      TicketMessage[]
  customerSegments    CustomerSegment[]
  customerSegmentMembers CustomerSegmentMember[]

  projects            Project[]
  projectTasks        ProjectTask[]
  workOrders          WorkOrder[]
  workOrderChecklistItems WorkOrderChecklistItem[]
  approvalRequests    ApprovalRequest[]
  entityComments      EntityComment[]
  entityAttachments   EntityAttachment[]
  notifications       Notification[]
  calendarEvents      OperationalCalendarEvent[]

  vehicles            Vehicle[]
  vehicleMileageRecords VehicleMileageRecord[]
  vehicleDocuments    VehicleDocument[]
  inspectionServices  InspectionService[]
  inspectionChecklistItems InspectionChecklistItem[]
  inspectionBookings  InspectionBooking[]
  inspectionFindings  InspectionFinding[]
  inspectionReports   InspectionReport[]
  workshopBays        WorkshopBay[]
  maintenanceBookings MaintenanceBooking[]
  jobCards            JobCard[]
  labourOperations    LabourOperation[]
  repairEstimates     RepairEstimate[]
  repairEstimateLines RepairEstimateLine[]
  partsReservations   PartsReservation[]
  partsReservationLines PartsReservationLine[]
  partReferences      PartReference[]
  partCompatibilities PartCompatibility[]
  warrantyRecords     WarrantyRecord[]
  serviceRequests     ServiceRequest[]
  marketplaceCommissions MarketplaceCommission[]

  // Execution 04 — customer platform, marketplace and mobile applications.
  customerAccounts          CustomerAccount[]
  bookingResources          BookingResource[]
  workingHours              WorkingHours[]
  bookingResourceExceptions BookingResourceException[]
  bookingSlots              BookingSlot[]
  bookingEvents             BookingEvent[]
  paymentIntents            PaymentIntent[]
  paymentTransactions       PaymentTransaction[]
  refunds                   Refund[]
  paymentReconciliations    PaymentReconciliation[]
  notificationDeliveries    NotificationDelivery[]

  // Execution 05 — per-tenant integration configuration.
  integrationProviders      IntegrationProvider[]

  @@index([type])
  @@index([status])
  @@index([parentCompanyId])
}

model Branch {
  id          String   @id @default(cuid())
  companyId   String
  code        String
  nameEn      String
  nameAr      String
  city        String?
  countryCode String?
  addressLine String?
  phone       String?
  timezone    String   @default("Asia/Riyadh")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships MembershipBranch[]

  // Execution 02 — branch-level operational scope.
  warehouses        Warehouse[]
  cashierSessions   CashierSession[]
  posSales          PosSale[]
  salesInvoices     SalesInvoice[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  supplierInvoices  SupplierInvoice[]
  payments          Payment[]
  journalEntries    JournalEntry[]

  // Execution 03 — branch scope for HR, operations and automotive.
  departments       Department[]
  employees         Employee[]
  projects          Project[]
  projectTasks      ProjectTask[]
  workOrders        WorkOrder[]
  calendarEvents    OperationalCalendarEvent[]
  inspectionBookings InspectionBooking[]
  maintenanceBookings MaintenanceBooking[]
  jobCards          JobCard[]
  workshopBays      WorkshopBay[]

  // Execution 04 — branch scope for the booking engine.
  bookingResources  BookingResource[]
  workingHours      WorkingHours[]
  bookingSlots      BookingSlot[]
  paymentIntents    PaymentIntent[]

  @@unique([companyId, code])
  @@index([companyId])
}

// ---------------------------------------------------------------- RBAC

model Role {
  id            String   @id @default(cuid())
  companyId     String?
  code          String
  nameEn        String
  nameAr        String
  descriptionEn String?
  isSystem      Boolean  @default(false)
  /** Platform roles are not editable by company admins. */
  isPlatform    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]

  @@unique([companyId, code])
  @@index([companyId])
}

model RolePermission {
  id             String @id @default(cuid())
  roleId         String
  permissionCode String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionCode])
  @@index([roleId])
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  companyId  String
  roleId     String
  isActive   Boolean  @default(true)
  invitedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branches MembershipBranch[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model MembershipBranch {
  id           String @id @default(cuid())
  membershipId String
  branchId     String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([membershipId, branchId])
  @@index([branchId])
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  companyId   String
  roleId      String
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy User?            @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  branches  InvitationBranch[]

  @@index([companyId])
  @@index([email])
}

model InvitationBranch {
  id           String @id @default(cuid())
  invitationId String
  branchId     String

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, branchId])
}

// ---------------------------------------------------------------- modules / plans

model Module {
  id             String       @id @default(cuid())
  key            String       @unique
  nameEn         String
  nameAr         String
  descriptionEn  String
  descriptionAr  String
  group          String
  icon           String
  route          String
  status         ModuleStatus @default(PLANNED)
  deliveryPhase  String
  readPermission String
  writePermission String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  planModules PlanModule[]

  @@index([group])
}

model Plan {
  id                 String   @id @default(cuid())
  code               String   @unique
  nameEn             String
  nameAr             String
  descriptionEn      String
  descriptionAr      String
  monthlyPrice       Decimal  @db.Decimal(12, 2)
  annualPrice        Decimal  @db.Decimal(12, 2)
  currency           String   @default("SAR")
  isPublic           Boolean  @default(true)
  isActive           Boolean  @default(true)
  trialDays          Int      @default(14)
  /** -1 means unlimited. */
  maxCompanies       Int      @default(1)
  maxBranches        Int      @default(1)
  maxUsers           Int      @default(5)
  storageMb          Int      @default(1024)
  apiRequestsPerMonth Int     @default(10000)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  modules       PlanModule[]
  subscriptions Subscription[]

  @@index([isActive])
}

model PlanModule {
  id        String @id @default(cuid())
  planId    String
  moduleKey String

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  @@unique([planId, moduleKey])
}

model Subscription {
  id               String             @id @default(cuid())
  companyId        String
  planId           String
  status           SubscriptionStatus @default(TRIAL)
  billingPeriod    BillingPeriod      @default(MONTHLY)
  price            Decimal            @db.Decimal(12, 2)
  currency         String             @default("SAR")
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  /** Denormalised snapshot of the licensed module keys at activation. */
  licensedModules  String[]           @default([])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  events  SubscriptionEvent[]

  @@index([companyId])
  @@index([status])
}

model SubscriptionEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  type           String
  fromStatus     String?
  toStatus       String?
  fromPlanId     String?
  toPlanId       String?
  amount         Decimal? @db.Decimal(12, 2)
  currency       String?
  note           String?
  actorUserId    String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// ---------------------------------------------------------------- governance

model SupportSession {
  id        String               @id @default(cuid())
  actorUserId String
  companyId String
  reason    String
  status    SupportSessionStatus @default(ACTIVE)
  expiresAt DateTime
  endedAt   DateTime?
  createdAt DateTime             @default(now())

  actor   User    @relation("SupportSessionActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([actorUserId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  companyId   String?
  action      String
  targetType  String
  targetId    String?
  summary     String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
}

// ---------------------------------------------------------------- website & app CMS

model CmsPage {
  id          String    @id @default(cuid())
  slug        String
  locale      Locale
  title       String
  excerpt     String?
  body        String
  status      CmsStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([slug, locale])
}

model CmsBanner {
  id        String  @id @default(cuid())
  placement String
  locale    Locale
  title     String
  subtitle  String?
  imageUrl  String?
  actionUrl String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, locale])
}

model FeatureFlag {
  id                String   @id @default(cuid())
  key               String   @unique
  nameEn            String
  nameAr            String
  description       String?
  enabled           Boolean  @default(false)
  audience          String   @default("all")
  rolloutPercentage Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AppVersion {
  id                  String         @id @default(cuid())
  platform            MobilePlatform
  version             String
  buildNumber         String
  releaseNotes        String?
  minSupportedVersion String
  isActive            Boolean        @default(false)
  releasedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([platform, version])
}

model ApiClient {
  id                String    @id @default(cuid())
  name              String
  clientId          String    @unique
  secretHash        String
  scopes            String[]  @default([])
  isActive          Boolean   @default(true)
  rateLimitPerMinute Int      @default(60)
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ServiceCategory {
  id         String   @id @default(cuid())
  key        String   @unique
  nameEn     String
  nameAr     String
  domain     String
  icon       String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  key       String
  channel   String
  locale    Locale
  subject   String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ============================================================================
// EXECUTION 02 — ENTERPRISE ERP CORE
//
// Every operational table carries `companyId` so tenant isolation is expressible
// in a query, never only in the UI. Monetary values are stored as integer minor
// units (halalas); quantities are scaled by 10^4. Percentages are stored as
// integer basis points (1500 = 15.00%). See packages/shared/src/money.ts.
// ============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountNormalBalance {
  DEBIT
  CREDIT
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum JournalSourceType {
  MANUAL
  SALES_INVOICE
  CREDIT_NOTE
  CUSTOMER_RECEIPT
  SUPPLIER_INVOICE
  SUPPLIER_PAYMENT
  GOODS_RECEIPT
  PURCHASE_RETURN
  POS_SALE
  STOCK_ADJUSTMENT
  OPENING_BALANCE
  WORKSHOP_INVOICE
  INSPECTION_INVOICE
  // Execution 04 — customer payments and marketplace settlements
  PAYMENT
  REFUND
  PROVIDER_COMMISSION
  PROVIDER_SETTLEMENT
}

enum PaymentDirection {
  RECEIPT
  PAYMENT
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  WALLET
  OTHER
}

enum AllocationTarget {
  SALES_INVOICE
  SUPPLIER_INVOICE
  CREDIT_NOTE
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum StockMovementType {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum StockMovementSource {
  MANUAL
  OPENING_BALANCE
  SALES_INVOICE
  CREDIT_NOTE
  GOODS_RECEIPT
  PURCHASE_RETURN
  TRANSFER
  ADJUSTMENT
  POS_SALE
}

enum TransferStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum AdjustmentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum DocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_INVOICED
  INVOICED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum SalesInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  VOID
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierInvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  VOID
}

enum CashierSessionStatus {
  OPEN
  CLOSED
}

enum PosSaleStatus {
  COMPLETED
  VOID
}

// ----------------------------------------------------------- document numbering

/** Monotonic per-company, per-document-type sequence. Never reused. */
model DocumentSequence {
  id         String   @id @default(cuid())
  companyId  String
  key        String
  prefix     String
  nextNumber Int      @default(1)
  padding    Int      @default(5)
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}

// ------------------------------------------------------------------- accounting

/** Chart-of-accounts node. `code` orders the tree; `parentId` nests it. */
model Account {
  id            String               @id @default(cuid())
  companyId     String
  code          String
  nameEn        String
  nameAr        String
  type          AccountType
  normalBalance AccountNormalBalance
  parentId      String?
  level         Int                  @default(1)
  isPostable    Boolean              @default(true)
  isSystem      Boolean              @default(false)
  /** System role tag (e.g. AR_CONTROL, AP_CONTROL, CASH, SALES_REVENUE, VAT_OUTPUT). */
  systemRole    String?
  currency      String               @default("SAR")
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Account? @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Account[] @relation("AccountTree")

  journalLines      JournalLine[]
  balances          AccountBalance[]
  customers         Customer[]
  suppliers         Supplier[]
  productsSales     Product[]  @relation("ProductSalesAccount")
  productsInventory Product[]  @relation("ProductInventoryAccount")
  productsCogs      Product[]  @relation("ProductCogsAccount")
  warehouses        Warehouse[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@index([companyId, systemRole])
  @@index([parentId])
}

/** Fiscal year. Only one year per company may be open at a time. */
model FiscalYear {
  id             String    @id @default(cuid())
  companyId      String
  code           String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean   @default(false)
  closedAt       DateTime?
  closedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periods FiscalPeriod[]

  @@unique([companyId, code])
  @@index([companyId, isClosed])
}

/** Accounting period inside a fiscal year. Posting is refused when not OPEN. */
model FiscalPeriod {
  id             String             @id @default(cuid())
  companyId      String
  fiscalYearId   String
  periodNumber   Int
  nameEn         String
  nameAr         String
  startDate      DateTime
  endDate        DateTime
  status         FiscalPeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedByUserId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear        @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  balances   AccountBalance[]
  entries    JournalEntry[]

  @@unique([fiscalYearId, periodNumber])
  @@index([companyId, status])
}

/** Balanced double-entry journal header. */
model JournalEntry {
  id               String            @id @default(cuid())
  companyId        String
  branchId         String?
  fiscalPeriodId   String?
  entryNumber      String
  entryDate        DateTime
  status           JournalStatus     @default(DRAFT)
  sourceType       JournalSourceType @default(MANUAL)
  /** Source document id, used to make posting idempotent. */
  sourceId         String?
  memo             String?
  currency         String            @default("SAR")
  totalDebitMinor  Int               @default(0)
  totalCreditMinor Int               @default(0)
  reversalOfId     String?
  postedAt         DateTime?
  postedByUserId   String?
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fiscalPeriod FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)

  lines      JournalLine[]
  reversal   JournalEntry?   @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy JournalEntry[]  @relation("JournalReversal")

  @@unique([companyId, entryNumber])
  // Idempotency: one journal per source document. Manual entries have a null
  // sourceId and are exempt (Postgres treats nulls as distinct in unique keys).
  @@unique([companyId, sourceType, sourceId])
  @@index([companyId, entryDate])
  @@index([companyId, status])
  @@index([branchId])
}

model JournalLine {
  id          String  @id @default(cuid())
  companyId   String
  entryId     String
  lineNumber  Int
  accountId   String
  branchId    String?
  description String?
  debitMinor  Int     @default(0)
  creditMinor Int     @default(0)

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([entryId, lineNumber])
  @@index([companyId, accountId])
}

/** Per-account, per-period aggregate kept in step with posted entries. */
model AccountBalance {
  id             String   @id @default(cuid())
  companyId      String
  accountId      String
  fiscalPeriodId String
  debitMinor     Int      @default(0)
  creditMinor    Int      @default(0)
  updatedAt      DateTime @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)

  @@unique([accountId, fiscalPeriodId])
  @@index([companyId])
}

/** Payment or receipt against a customer or supplier. */
model Payment {
  id             String           @id @default(cuid())
  companyId      String
  branchId       String?
  direction      PaymentDirection
  partyType      PartyType
  customerId     String?
  supplierId     String?
  paymentNumber  String
  method         PaymentMethod    @default(CASH)
  amountMinor    Int
  currency       String           @default("SAR")
  reference      String?
  notes          String?
  paidAt         DateTime
  journalEntryId String?
  idempotencyKey String?
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  allocations PaymentAllocation[]

  @@unique([companyId, paymentNumber])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, partyType])
  @@index([companyId, paidAt])
}

model PaymentAllocation {
  id                String          @id @default(cuid())
  companyId         String
  paymentId         String
  target            AllocationTarget
  salesInvoiceId    String?
  supplierInvoiceId String?
  creditNoteId      String?
  amountMinor       Int
  createdAt         DateTime        @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment         Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  salesInvoice    SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  supplierInvoice SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)
  creditNote      CreditNote?      @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([companyId])
}

// -------------------------------------------------------------------- inventory

model Warehouse {
  id                 String   @id @default(cuid())
  companyId          String
  branchId           String?
  code               String
  nameEn             String
  nameAr             String
  addressLine        String?
  inventoryAccountId String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch           Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  inventoryAccount Account?        @relation(fields: [inventoryAccountId], references: [id], onDelete: SetNull)
  levels           StockLevel[]
  movements        StockMovement[]

  @@unique([companyId, code])
  @@index([companyId])
}

/** Sellable / stockable item. Serves both the sales catalog and inventory. */
model Product {
  id                 String      @id @default(cuid())
  companyId          String
  sku                String
  nameEn             String
  nameAr             String
  type               ProductType @default(PRODUCT)
  unit               String      @default("unit")
  barcode            String?
  salesPriceMinor    Int         @default(0)
  costPriceMinor     Int         @default(0)
  /** Default VAT rate in basis points (1500 = 15.00%). */
  taxRateBp          Int         @default(0)
  /** Reorder threshold, scaled by 10^4. */
  reorderLevel       Int         @default(0)
  reorderQuantity    Int         @default(0)
  trackStock         Boolean     @default(true)
  salesAccountId     String?
  inventoryAccountId String?
  cogsAccountId      String?
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesAccount     Account? @relation("ProductSalesAccount", fields: [salesAccountId], references: [id], onDelete: SetNull)
  inventoryAccount Account? @relation("ProductInventoryAccount", fields: [inventoryAccountId], references: [id], onDelete: SetNull)
  cogsAccount      Account? @relation("ProductCogsAccount", fields: [cogsAccountId], references: [id], onDelete: SetNull)

  levels    StockLevel[]
  movements StockMovement[]

  // Execution 03
  partReferences   PartReference[]
  partCompatibilities PartCompatibility[]
  reservationLines PartsReservationLine[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
}

/** Current on-hand quantity and moving-average cost for a product in a warehouse. */
model StockLevel {
  id               String   @id @default(cuid())
  companyId        String
  warehouseId      String
  productId        String
  /** On-hand quantity, scaled by 10^4. */
  quantity         Int      @default(0)
  /** Moving-average unit cost in minor units. */
  averageCostMinor Int      @default(0)
  updatedAt        DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([companyId])
  @@index([companyId, productId])
}

/** Append-only stock ledger. `balanceAfter` is the on-hand after this movement. */
model StockMovement {
  id             String              @id @default(cuid())
  companyId      String
  branchId       String?
  warehouseId    String
  productId      String
  movementType   StockMovementType
  /** Signed quantity, scaled by 10^4. */
  quantity       Int
  unitCostMinor  Int                 @default(0)
  totalCostMinor Int                 @default(0)
  balanceAfter   Int
  source         StockMovementSource @default(MANUAL)
  sourceId       String?
  memo           String?
  occurredAt     DateTime
  createdById    String
  createdAt      DateTime            @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, warehouseId, productId])
  @@index([companyId, occurredAt])
  @@index([companyId, source, sourceId])
}

model StockTransfer {
  id              String         @id @default(cuid())
  companyId       String
  branchId        String?
  transferNumber  String
  fromWarehouseId String
  toWarehouseId   String
  status          TransferStatus @default(DRAFT)
  notes           String?
  postedAt        DateTime?
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   StockTransferLine[]

  @@unique([companyId, transferNumber])
  @@index([companyId, status])
}

model StockTransferLine {
  id         String @id @default(cuid())
  transferId String
  productId  String
  /** Quantity to move, scaled by 10^4. */
  quantity   Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@unique([transferId, productId])
}

model StockAdjustment {
  id               String           @id @default(cuid())
  companyId        String
  branchId         String?
  adjustmentNumber String
  warehouseId      String
  reason           String
  status           AdjustmentStatus @default(DRAFT)
  postedAt         DateTime?
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   StockAdjustmentLine[]

  @@unique([companyId, adjustmentNumber])
  @@index([companyId, status])
}

model StockAdjustmentLine {
  id            String @id @default(cuid())
  adjustmentId  String
  productId     String
  /** Signed delta, scaled by 10^4 (positive increases stock). */
  quantityDelta Int
  unitCostMinor Int    @default(0)

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@unique([adjustmentId, productId])
}

// ------------------------------------------------------------------------ sales

model Customer {
  id                  String   @id @default(cuid())
  companyId           String
  code                String
  nameEn              String
  nameAr              String
  email               String?
  phone               String?
  taxNumber           String?
  addressLine         String?
  city                String?
  countryCode         String?
  creditLimitMinor    Int      @default(0)
  paymentTermsDays    Int      @default(0)
  /** Control account for this customer's receivable. */
  receivableAccountId String?
  currency            String   @default("SAR")
  isActive            Boolean  @default(true)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  receivableAccount Account? @relation(fields: [receivableAccountId], references: [id], onDelete: SetNull)

  quotations  Quotation[]
  orders      SalesOrder[]
  invoices    SalesInvoice[]
  creditNotes CreditNote[]
  posSales    PosSale[]
  payments    Payment[]

  // Execution 03
  contacts          CustomerContact[]
  vehicles          Vehicle[]
  segmentMemberships CustomerSegmentMember[]

  // Execution 04 — the same tenant customer record is reachable from a
  // consumer account through the vehicle and booking relations.
  bookingSlots      BookingSlot[]
  paymentIntents    PaymentIntent[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model Quotation {
  id               String          @id @default(cuid())
  companyId        String
  branchId         String?
  quoteNumber      String
  customerId       String
  status           QuotationStatus @default(DRAFT)
  issueDate        DateTime        @default(now())
  validUntil       DateTime?
  subtotalMinor    Int             @default(0)
  discountMinor    Int             @default(0)
  taxMinor         Int             @default(0)
  totalMinor       Int             @default(0)
  currency         String          @default("SAR")
  notes            String?
  convertedOrderId String?
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines    QuotationLine[]

  @@unique([companyId, quoteNumber])
  @@index([companyId, status])
}

model QuotationLine {
  id                String @id @default(cuid())
  quotationId       String
  productId         String?
  description       String
  quantity          Int
  unitPriceMinor    Int
  discountPercentBp Int    @default(0)
  taxPercentBp      Int    @default(0)
  lineTotalMinor    Int
  sortOrder         Int    @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model SalesOrder {
  id            String           @id @default(cuid())
  companyId     String
  branchId      String?
  orderNumber   String
  customerId    String
  quotationId   String?
  warehouseId   String?
  status        SalesOrderStatus @default(DRAFT)
  orderDate     DateTime         @default(now())
  subtotalMinor Int              @default(0)
  discountMinor Int              @default(0)
  taxMinor      Int              @default(0)
  totalMinor    Int              @default(0)
  currency      String           @default("SAR")
  notes         String?
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines    SalesOrderLine[]
  invoices SalesInvoice[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
}

model SalesOrderLine {
  id                String @id @default(cuid())
  orderId           String
  productId         String?
  description       String
  quantity          Int
  quantityInvoiced  Int    @default(0)
  unitPriceMinor    Int
  discountPercentBp Int    @default(0)
  taxPercentBp      Int    @default(0)
  lineTotalMinor    Int
  sortOrder         Int    @default(0)

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model SalesInvoice {
  id              String             @id @default(cuid())
  companyId       String
  branchId        String?
  invoiceNumber   String
  customerId      String
  orderId         String?
  warehouseId     String?
  status          SalesInvoiceStatus @default(DRAFT)
  invoiceDate     DateTime           @default(now())
  dueDate         DateTime?
  subtotalMinor   Int                @default(0)
  discountMinor   Int                @default(0)
  taxMinor        Int                @default(0)
  totalMinor      Int                @default(0)
  amountPaidMinor Int                @default(0)
  currency        String             @default("SAR")
  notes           String?
  journalEntryId  String?
  createdById     String
  postedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch      Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order       SalesOrder?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lines       SalesInvoiceLine[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]

  @@unique([companyId, invoiceNumber])
  @@unique([companyId, orderId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([branchId])
}

model SalesInvoiceLine {
  id                String @id @default(cuid())
  invoiceId         String
  productId         String?
  description       String
  quantity          Int
  unitPriceMinor    Int
  discountPercentBp Int    @default(0)
  taxPercentBp      Int    @default(0)
  lineSubtotalMinor Int
  discountMinor     Int    @default(0)
  taxMinor          Int    @default(0)
  lineTotalMinor    Int
  sortOrder         Int    @default(0)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model CreditNote {
  id               String         @id @default(cuid())
  companyId        String
  branchId         String?
  creditNoteNumber String
  customerId       String
  invoiceId        String?
  warehouseId      String?
  status           DocumentStatus @default(DRAFT)
  issueDate        DateTime       @default(now())
  subtotalMinor    Int            @default(0)
  taxMinor         Int            @default(0)
  totalMinor       Int            @default(0)
  reason           String?
  currency         String         @default("SAR")
  restockInventory Boolean        @default(false)
  journalEntryId   String?
  createdById      String
  postedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice     SalesInvoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  lines       CreditNoteLine[]
  allocations PaymentAllocation[]

  @@unique([companyId, creditNoteNumber])
  @@index([companyId, status])
}

model CreditNoteLine {
  id             String @id @default(cuid())
  creditNoteId   String
  productId      String?
  description    String
  quantity       Int
  unitPriceMinor Int
  taxPercentBp   Int    @default(0)
  lineTotalMinor Int
  sortOrder      Int    @default(0)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
}

/** Cashier shift for a POS terminal. Expected cash is derived from POS sales. */
model CashierSession {
  id                String               @id @default(cuid())
  companyId         String
  branchId          String
  warehouseId       String?
  sessionNumber     String
  status            CashierSessionStatus @default(OPEN)
  openingFloatMinor Int                  @default(0)
  expectedCashMinor Int                  @default(0)
  countedCashMinor  Int?
  varianceMinor     Int?
  openedById        String
  openedAt          DateTime             @default(now())
  closedById        String?
  closedAt          DateTime?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sales   PosSale[]

  @@unique([companyId, sessionNumber])
  @@index([companyId, status])
  @@index([branchId])
}

model PosSale {
  id               String        @id @default(cuid())
  companyId        String
  branchId         String
  cashierSessionId String
  receiptNumber    String
  customerId       String?
  warehouseId      String?
  status           PosSaleStatus @default(COMPLETED)
  subtotalMinor    Int           @default(0)
  discountMinor    Int           @default(0)
  taxMinor         Int           @default(0)
  totalMinor       Int           @default(0)
  paidMinor        Int           @default(0)
  changeMinor      Int           @default(0)
  paymentMethod    PaymentMethod @default(CASH)
  currency         String        @default("SAR")
  salesInvoiceId   String?
  journalEntryId   String?
  createdById      String
  createdAt        DateTime      @default(now())

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashierSession CashierSession @relation(fields: [cashierSessionId], references: [id], onDelete: Restrict)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines          PosSaleLine[]

  @@unique([companyId, receiptNumber])
  @@index([companyId, createdAt])
  @@index([cashierSessionId])
}

model PosSaleLine {
  id             String @id @default(cuid())
  posSaleId      String
  productId      String?
  description    String
  quantity       Int
  unitPriceMinor Int
  discountMinor  Int    @default(0)
  taxPercentBp   Int    @default(0)
  taxMinor       Int    @default(0)
  lineTotalMinor Int

  posSale PosSale @relation(fields: [posSaleId], references: [id], onDelete: Cascade)

  @@index([posSaleId])
}

// ------------------------------------------------------------------ procurement

model Supplier {
  id               String   @id @default(cuid())
  companyId        String
  code             String
  nameEn           String
  nameAr           String
  email            String?
  phone            String?
  taxNumber        String?
  addressLine      String?
  city             String?
  countryCode      String?
  paymentTermsDays Int      @default(0)
  /** Control account for this supplier's payable. */
  payableAccountId String?
  currency         String   @default("SAR")
  isActive         Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payableAccount Account? @relation(fields: [payableAccountId], references: [id], onDelete: SetNull)

  requisitions PurchaseRequisition[]
  orders       PurchaseOrder[]
  receipts     GoodsReceipt[]
  invoices     SupplierInvoice[]
  returns      PurchaseReturn[]
  payments     Payment[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model PurchaseRequisition {
  id                String            @id @default(cuid())
  companyId         String
  branchId          String?
  requisitionNumber String
  status            RequisitionStatus @default(DRAFT)
  requestedById     String
  neededBy          DateTime?
  supplierId        String?
  notes             String?
  approvedById      String?
  approvedAt        DateTime?
  convertedOrderId  String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines    PurchaseRequisitionLine[]

  @@unique([companyId, requisitionNumber])
  @@index([companyId, status])
}

model PurchaseRequisitionLine {
  id                     String @id @default(cuid())
  requisitionId          String
  productId              String?
  description            String
  quantity               Int
  estimatedUnitCostMinor Int    @default(0)
  sortOrder              Int    @default(0)

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  companyId     String
  branchId      String?
  orderNumber   String
  supplierId    String
  requisitionId String?
  warehouseId   String?
  status        PurchaseOrderStatus @default(DRAFT)
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  subtotalMinor Int                 @default(0)
  taxMinor      Int                 @default(0)
  totalMinor    Int                 @default(0)
  currency      String              @default("SAR")
  notes         String?
  approvedById  String?
  approvedAt    DateTime?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]
  invoices SupplierInvoice[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([branchId])
}

model PurchaseOrderLine {
  id               String @id @default(cuid())
  orderId          String
  productId        String?
  description      String
  quantity         Int
  quantityReceived Int    @default(0)
  unitCostMinor    Int
  taxPercentBp     Int    @default(0)
  lineTotalMinor   Int
  sortOrder        Int    @default(0)

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model GoodsReceipt {
  id              String         @id @default(cuid())
  companyId       String
  branchId        String?
  receiptNumber   String
  purchaseOrderId String
  supplierId      String
  warehouseId     String
  status          DocumentStatus @default(DRAFT)
  receivedAt      DateTime       @default(now())
  notes           String?
  journalEntryId  String?
  receivedById    String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch        Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines         GoodsReceiptLine[]

  @@unique([companyId, receiptNumber])
  @@index([companyId, status])
}

model GoodsReceiptLine {
  id            String @id @default(cuid())
  receiptId     String
  productId     String
  description   String
  quantity      Int
  unitCostMinor Int
  sortOrder     Int    @default(0)

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model SupplierInvoice {
  id                    String                @id @default(cuid())
  companyId             String
  branchId              String?
  invoiceNumber         String
  supplierInvoiceNumber String
  supplierId            String
  purchaseOrderId       String?
  status                SupplierInvoiceStatus @default(DRAFT)
  invoiceDate           DateTime              @default(now())
  dueDate               DateTime?
  subtotalMinor         Int                   @default(0)
  taxMinor              Int                   @default(0)
  totalMinor            Int                   @default(0)
  amountPaidMinor       Int                   @default(0)
  currency              String                @default("SAR")
  notes                 String?
  journalEntryId        String?
  createdById           String
  postedAt              DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch        Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  lines         SupplierInvoiceLine[]
  allocations   PaymentAllocation[]

  @@unique([companyId, invoiceNumber])
  @@unique([companyId, supplierId, supplierInvoiceNumber])
  @@index([companyId, status])
}

model SupplierInvoiceLine {
  id                String @id @default(cuid())
  invoiceId         String
  productId         String?
  description       String
  quantity          Int
  unitCostMinor     Int
  taxPercentBp      Int    @default(0)
  lineSubtotalMinor Int
  taxMinor          Int    @default(0)
  lineTotalMinor    Int
  sortOrder         Int    @default(0)

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PurchaseReturn {
  id              String         @id @default(cuid())
  companyId       String
  branchId        String?
  returnNumber    String
  supplierId      String
  purchaseOrderId String?
  warehouseId     String
  status          DocumentStatus @default(DRAFT)
  returnDate      DateTime       @default(now())
  subtotalMinor   Int            @default(0)
  taxMinor        Int            @default(0)
  totalMinor      Int            @default(0)
  reason          String?
  currency        String         @default("SAR")
  journalEntryId  String?
  createdById     String
  postedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    PurchaseReturnLine[]

  @@unique([companyId, returnNumber])
  @@index([companyId, status])
}

model PurchaseReturnLine {
  id             String @id @default(cuid())
  returnId       String
  productId      String
  description    String
  quantity       Int
  unitCostMinor  Int
  taxPercentBp   Int    @default(0)
  lineTotalMinor Int
  sortOrder      Int    @default(0)

  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

// ============================================================================
// EXECUTION 03 — HR & PAYROLL, CRM, OPERATIONS, AUTOMOTIVE SERVICES
//
// Every tenant-owned row carries `companyId`. Money is integer minor units;
// quantities are scaled by 10^4; hours and leave days are scaled by 100
// (hundredths); percentages are basis points (1500 = 15.00%). Payroll and
// workshop postings go through the Execution 02 double-entry engine, so there is
// one ledger and one accounting system, never a parallel one.
// ============================================================================

// ------------------------------------------------------------------- HR enums

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  PART_TIME
  CONTRACTOR
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum EmployeeDocumentCategory {
  IDENTITY
  CONTRACT
  CERTIFICATE
  MEDICAL
  OTHER
}

enum LifecycleType {
  ONBOARDING
  OFFBOARDING
}

enum LifecycleStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum LeaveRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum SalaryComponentType {
  ALLOWANCE
  DEDUCTION
}

enum PayrollPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  POSTED
  LOCKED
  CANCELLED
}

enum AdvanceStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
}

// ------------------------------------------------------------------ CRM enums

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  NOTE
  TASK
  FOLLOW_UP
}

enum ActivityStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

// ----------------------------------------------------------- Operations enums

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkOrderStatus {
  DRAFT
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  INFO
  TASK
  APPROVAL
  ALERT
}

// ----------------------------------------------------------- Automotive enums

enum VehicleStatus {
  ACTIVE
  INACTIVE
  SOLD
}

enum InspectionBookingStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FindingSeverity {
  INFO
  MINOR
  MAJOR
  CRITICAL
}

enum InspectionReportStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum MaintenanceBookingStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobCardStatus {
  DRAFT
  OPEN
  AWAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  INVOICED
  CANCELLED
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum EstimateLineType {
  LABOUR
  PART
  SERVICE
}

enum ReservationStatus {
  RESERVED
  PARTIALLY_ISSUED
  ISSUED
  CANCELLED
}

enum PartNumberType {
  OEM
  AFTERMARKET
  CROSS_REFERENCE
}

enum ProviderStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum ServiceRequestStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  INVOICED
  SETTLED
  CANCELLED
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

// ============================================================================
// PHASE 2 — HUMAN RESOURCES & PAYROLL
// ============================================================================

model Department {
  id         String   @id @default(cuid())
  companyId  String
  code       String
  nameEn     String
  nameAr     String
  parentId   String?
  branchId   String?
  managerEmployeeId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Department? @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")

  jobTitles JobTitle[]
  employees Employee[]
  workOrders WorkOrder[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

model JobTitle {
  id           String   @id @default(cuid())
  companyId    String
  code         String
  nameEn       String
  nameAr       String
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees  Employee[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model Employee {
  id             String         @id @default(cuid())
  companyId      String
  code           String
  fullNameEn     String
  fullNameAr     String
  email          String?
  phone          String?
  nationalId     String?
  /** Optional link to a platform user account. */
  userId         String?
  departmentId   String?
  jobTitleId     String?
  branchId       String?
  /** Reporting line. */
  managerId      String?
  status         EmployeeStatus @default(ACTIVE)
  hireDate       DateTime
  terminationDate DateTime?
  dateOfBirth    DateTime?
  gender         String?
  addressLine    String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobTitle   JobTitle?   @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manager    Employee?   @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports    Employee[]  @relation("EmployeeManager")

  contracts      EmploymentContract[]
  documents      EmployeeDocument[]
  lifecycle      EmployeeLifecycle[]
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  attendance     AttendanceRecord[]
  shiftAssignments EmployeeShift[]
  salaryStructures SalaryStructure[]
  payslips       Payslip[]
  advances       EmployeeAdvance[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@index([managerId])
}

model EmploymentContract {
  id            String         @id @default(cuid())
  companyId     String
  employeeId    String
  contractNumber String
  type          ContractType   @default(PERMANENT)
  status        ContractStatus @default(DRAFT)
  startDate     DateTime
  endDate       DateTime?
  /** Contracted base salary at signing, in minor units. */
  baseSalaryMinor Int
  currency      String         @default("SAR")
  probationDays Int            @default(0)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, contractNumber])
  @@index([companyId, employeeId])
}

model EmployeeDocument {
  id         String                  @id @default(cuid())
  companyId  String
  employeeId String
  category   EmployeeDocumentCategory @default(OTHER)
  title      String
  fileRef    String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  /** When true only a principal holding the confidential-documents permission may read it. */
  isConfidential Boolean            @default(false)
  notes      String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
}

/** Onboarding or offboarding checklist for an employee. */
model EmployeeLifecycle {
  id         String          @id @default(cuid())
  companyId  String
  employeeId String
  type       LifecycleType
  status     LifecycleStatus @default(OPEN)
  startedAt  DateTime        @default(now())
  completedAt DateTime?
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items    EmployeeLifecycleItem[]

  @@index([companyId, employeeId])
}

model EmployeeLifecycleItem {
  id          String  @id @default(cuid())
  lifecycleId String
  label       String
  isDone      Boolean @default(false)
  doneAt      DateTime?
  sortOrder   Int     @default(0)

  lifecycle EmployeeLifecycle @relation(fields: [lifecycleId], references: [id], onDelete: Cascade)

  @@index([lifecycleId])
}

model LeaveType {
  id        String   @id @default(cuid())
  companyId String
  code      String
  nameEn    String
  nameAr    String
  /** Annual entitlement in hundredths of a day (2500 = 25 days). */
  annualEntitlementDays Int @default(0)
  isPaid    Boolean  @default(true)
  requiresApproval Boolean @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, code])
}

model LeaveBalance {
  id          String   @id @default(cuid())
  companyId   String
  employeeId  String
  leaveTypeId String
  year        Int
  /** All in hundredths of a day. */
  entitledDays Int     @default(0)
  accruedDays  Int     @default(0)
  usedDays     Int     @default(0)
  pendingDays  Int     @default(0)
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([companyId])
}

model LeaveRequest {
  id          String            @id @default(cuid())
  companyId   String
  employeeId  String
  leaveTypeId String
  startDate   DateTime
  endDate     DateTime
  /** Total days requested in hundredths of a day. */
  days        Int
  status      LeaveRequestStatus @default(DRAFT)
  reason      String?
  approvedById String?
  decidedAt   DateTime?
  decisionNote String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([companyId, employeeId])
}

model Shift {
  id          String   @id @default(cuid())
  companyId   String
  code        String
  nameEn      String
  nameAr      String
  startTime   String
  endTime     String
  breakMinutes Int     @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments EmployeeShift[]
  attendance  AttendanceRecord[]

  @@unique([companyId, code])
}

model EmployeeShift {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  shiftId    String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  companyId      String
  employeeId     String
  shiftId        String?
  workDate       DateTime
  checkInAt      DateTime?
  checkOutAt     DateTime?
  workedMinutes  Int              @default(0)
  overtimeMinutes Int             @default(0)
  status         AttendanceStatus @default(PRESENT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([employeeId, workDate])
  @@index([companyId, workDate])
}

/** Effective-dated salary structure. A payroll run snapshots it. */
model SalaryStructure {
  id            String   @id @default(cuid())
  companyId     String
  employeeId    String
  effectiveFrom DateTime
  /** Base monthly salary in minor units. */
  basicMinor    Int
  currency      String   @default("SAR")
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  components SalaryComponent[]

  @@index([companyId, employeeId, effectiveFrom])
}

model SalaryComponent {
  id                String             @id @default(cuid())
  companyId         String
  salaryStructureId String
  type              SalaryComponentType
  code              String
  nameEn            String
  nameAr            String
  /** Fixed amount in minor units when isPercentage is false. */
  amountMinor       Int                @default(0)
  isPercentage      Boolean            @default(false)
  /** Percentage of basic in basis points when isPercentage is true. */
  percentBp         Int                @default(0)
  sortOrder         Int                @default(0)

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@unique([salaryStructureId, code])
  @@index([companyId])
}

model PayrollPeriod {
  id        String              @id @default(cuid())
  companyId String
  code      String
  nameEn    String
  nameAr    String
  startDate DateTime
  endDate   DateTime
  status    PayrollPeriodStatus @default(OPEN)
  closedAt  DateTime?
  closedByUserId String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runs    PayrollRun[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model PayrollRun {
  id             String           @id @default(cuid())
  companyId      String
  periodId       String
  runNumber      String
  status         PayrollRunStatus @default(DRAFT)
  employeeCount  Int              @default(0)
  grossMinor     Int              @default(0)
  allowancesMinor Int             @default(0)
  deductionsMinor Int             @default(0)
  netMinor       Int              @default(0)
  currency       String           @default("SAR")
  journalEntryId String?
  approvedById   String?
  approvedAt     DateTime?
  postedAt       DateTime?
  createdById    String
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period  PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  payslips Payslip[]

  @@unique([companyId, runNumber])
  @@index([companyId, status])
  @@index([companyId, periodId])
}

/** Immutable result of one employee in one run. Snapshots the structure. */
model Payslip {
  id            String   @id @default(cuid())
  companyId     String
  payrollRunId  String
  employeeId    String
  employeeCode  String
  employeeNameEn String
  employeeNameAr String
  basicMinor    Int
  allowancesMinor Int    @default(0)
  deductionsMinor Int    @default(0)
  grossMinor    Int      @default(0)
  netMinor      Int      @default(0)
  currency      String   @default("SAR")
  advanceDeductionMinor Int @default(0)
  /** Full snapshot of the salary structure and computed components at run time. */
  snapshot      Json?
  createdAt     DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines      PayslipLine[]

  @@unique([payrollRunId, employeeId])
  @@index([companyId, employeeId])
}

model PayslipLine {
  id           String             @id @default(cuid())
  payslipId    String
  type         SalaryComponentType
  code         String
  nameEn       String
  nameAr       String
  amountMinor  Int
  sortOrder    Int                @default(0)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}

model EmployeeAdvance {
  id            String        @id @default(cuid())
  companyId     String
  employeeId    String
  advanceNumber String
  amountMinor   Int
  installments  Int           @default(1)
  settledMinor  Int           @default(0)
  currency      String        @default("SAR")
  status        AdvanceStatus @default(OPEN)
  issuedAt      DateTime
  reason        String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  settlements AdvanceSettlement[]

  @@unique([companyId, advanceNumber])
  @@index([companyId, employeeId])
}

model AdvanceSettlement {
  id            String   @id @default(cuid())
  companyId     String
  advanceId     String
  payrollRunId  String?
  amountMinor   Int
  settledAt     DateTime @default(now())
  note          String?

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  advance EmployeeAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  @@index([companyId, advanceId])
}

// ============================================================================
// PHASE 3 — CRM & CUSTOMER SERVICE
// ============================================================================

model LeadSource {
  id        String   @id @default(cuid())
  companyId String
  code      String
  nameEn    String
  nameAr    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads   Lead[]

  @@unique([companyId, code])
}

model Lead {
  id            String     @id @default(cuid())
  companyId     String
  code          String
  nameEn        String
  nameAr        String
  contactName   String?
  email         String?
  phone         String?
  sourceId      String?
  status        LeadStatus @default(NEW)
  ownerUserId   String?
  estimatedValueMinor Int  @default(0)
  currency      String     @default("SAR")
  notes         String?
  /** Set when the lead is converted to a customer. */
  customerId    String?
  convertedOpportunityId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source   LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  opportunities Opportunity[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model Pipeline {
  id        String   @id @default(cuid())
  companyId String
  code      String
  nameEn    String
  nameAr    String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stages  PipelineStage[]
  opportunities Opportunity[]

  @@unique([companyId, code])
}

model PipelineStage {
  id           String   @id @default(cuid())
  companyId    String
  pipelineId   String
  code         String
  nameEn       String
  nameAr       String
  sortOrder    Int      @default(0)
  /** Win probability in basis points. */
  probabilityBp Int     @default(0)
  isWon        Boolean  @default(false)
  isLost       Boolean  @default(false)

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pipeline     Pipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, code])
  @@index([companyId])
}

model Opportunity {
  id            String            @id @default(cuid())
  companyId     String
  code          String
  title         String
  pipelineId    String
  stageId       String
  customerId    String?
  leadId        String?
  ownerUserId   String?
  amountMinor   Int               @default(0)
  currency      String            @default("SAR")
  expectedCloseDate DateTime?
  status        OpportunityStatus @default(OPEN)
  /** Set when converted into a quotation. */
  quotationId   String?
  notes         String?
  closedAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pipeline Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage    PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  lead     Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, stageId])
}

model CustomerContact {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  nameEn     String
  nameAr     String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, customerId])
}

model CrmActivity {
  id            String         @id @default(cuid())
  companyId     String
  type          ActivityType
  status        ActivityStatus @default(OPEN)
  subject       String
  notes         String?
  dueAt         DateTime?
  completedAt   DateTime?
  ownerUserId   String?
  customerId    String?
  leadId        String?
  opportunityId String?
  ticketId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, ownerUserId])
  @@index([companyId, dueAt])
}

model SlaPolicy {
  id                String          @id @default(cuid())
  companyId         String
  name              String
  priority          TicketPriority
  responseMinutes   Int
  resolutionMinutes Int
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, priority])
}

model SupportTicket {
  id             String         @id @default(cuid())
  companyId      String
  ticketNumber   String
  subject        String
  description    String?
  customerId     String?
  contactId      String?
  /** The consumer account that raised this ticket from the website or app. */
  customerAccountId String?
  category       String?
  priority       TicketPriority @default(NORMAL)
  status         TicketStatus   @default(NEW)
  assignedToUserId String?
  /** Response/resolution targets derived from the SLA policy at creation. */
  responseDueAt  DateTime?
  resolutionDueAt DateTime?
  firstResponseAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  satisfactionScore Int?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@unique([companyId, ticketNumber])
  @@index([companyId, status])
  @@index([companyId, assignedToUserId])
  @@index([customerAccountId])
}

model TicketMessage {
  id           String   @id @default(cuid())
  companyId    String
  ticketId     String
  authorUserId String?
  body         String
  isInternal   Boolean  @default(false)
  createdAt    DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticket  SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model CustomerSegment {
  id        String   @id @default(cuid())
  companyId String
  code      String
  nameEn    String
  nameAr    String
  description String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members CustomerSegmentMember[]

  @@unique([companyId, code])
}

model CustomerSegmentMember {
  id         String   @id @default(cuid())
  companyId  String
  segmentId  String
  customerId String
  addedAt    DateTime @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segment  CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([segmentId, customerId])
  @@index([companyId])
}

// ============================================================================
// PHASE 4 — OPERATIONS & WORK MANAGEMENT
// ============================================================================

model Project {
  id          String        @id @default(cuid())
  companyId   String
  code        String
  nameEn      String
  nameAr      String
  branchId    String?
  departmentId String?
  status      ProjectStatus @default(PLANNED)
  ownerUserId String?
  startDate   DateTime?
  endDate     DateTime?
  description String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tasks   ProjectTask[]
  workOrders WorkOrder[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model ProjectTask {
  id           String       @id @default(cuid())
  companyId    String
  projectId    String?
  parentTaskId String?
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(NORMAL)
  assigneeUserId String?
  branchId     String?
  dueDate      DateTime?
  completedAt  DateTime?
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  project  Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   ProjectTask?  @relation("TaskTree", fields: [parentTaskId], references: [id], onDelete: Cascade)
  children ProjectTask[] @relation("TaskTree")

  @@index([companyId, status])
  @@index([companyId, assigneeUserId])
}

model WorkOrder {
  id            String          @id @default(cuid())
  companyId     String
  orderNumber   String
  title         String
  description   String?
  type          String          @default("GENERAL")
  branchId      String?
  departmentId  String?
  projectId     String?
  status        WorkOrderStatus @default(DRAFT)
  priority      TaskPriority    @default(NORMAL)
  requestedById String?
  assigneeUserId String?
  dueDate       DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  /** Optional link to a CRM service request or an automotive job card. */
  sourceType    String?
  sourceId      String?
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  checklist  WorkOrderChecklistItem[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([companyId, assigneeUserId])
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

model WorkOrderChecklistItem {
  id          String   @id @default(cuid())
  companyId   String
  workOrderId String
  label       String
  isDone      Boolean  @default(false)
  doneAt      DateTime?
  sortOrder   Int      @default(0)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  companyId     String
  entityType    String
  entityId      String
  status        ApprovalStatus @default(PENDING)
  requestedById String
  approverUserId String?
  decidedAt     DateTime?
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
  @@index([companyId, status])
}

/** A comment on any operational entity, addressed by type + id. */
model EntityComment {
  id           String   @id @default(cuid())
  companyId    String
  entityType   String
  entityId     String
  authorUserId String?
  body         String
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
}

model EntityAttachment {
  id         String   @id @default(cuid())
  companyId  String
  entityType String
  entityId   String
  fileName   String
  mimeType   String?
  sizeBytes  Int      @default(0)
  /** Opaque storage reference; no binary is stored in the database. */
  storageRef String?
  uploadedById String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
}

/** Internal, database-persisted notification. No external provider is claimed. */
model Notification {
  id         String           @id @default(cuid())
  companyId  String
  userId     String
  type       NotificationType @default(INFO)
  title      String
  body       String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, readAt])
}

model OperationalCalendarEvent {
  id         String   @id @default(cuid())
  companyId  String
  branchId   String?
  title      String
  description String?
  startAt    DateTime
  endAt      DateTime
  allDay     Boolean  @default(false)
  entityType String?
  entityId   String?
  createdById String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, startAt])
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

// ============================================================================
// PHASE 5 — AUTOMOTIVE SERVICE MANAGEMENT
// ============================================================================

model Vehicle {
  id           String        @id @default(cuid())
  companyId    String
  customerId   String
  /** The consumer account that owns this vehicle, when registered from the app. */
  customerAccountId String?
  /** VIN/chassis number, unique per company. */
  vin          String
  plateNumber  String?
  make         String
  model        String
  modelYear    Int
  color        String?
  mileage      Int           @default(0)
  status       VehicleStatus @default(ACTIVE)
  registrationExpiresAt DateTime?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /** Ownership link for the customer website and mobile garage. */
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  mileageRecords VehicleMileageRecord[]
  documents      VehicleDocument[]
  inspections    InspectionBooking[]
  maintenance    MaintenanceBooking[]
  jobCards       JobCard[]
  warranties     WarrantyRecord[]
  bookingSlots   BookingSlot[]

  @@unique([companyId, vin])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([customerAccountId])
}

model VehicleMileageRecord {
  id         String   @id @default(cuid())
  companyId  String
  vehicleId  String
  mileage    Int
  source     String   @default("MANUAL")
  recordedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId, vehicleId])
}

model VehicleDocument {
  id         String   @id @default(cuid())
  companyId  String
  vehicleId  String
  category   String
  number     String?
  expiresAt  DateTime?
  fileRef    String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId, vehicleId])
}

model InspectionService {
  id              String   @id @default(cuid())
  companyId       String
  code            String
  nameEn          String
  nameAr          String
  description     String?
  priceMinor      Int      @default(0)
  taxPercentBp    Int      @default(0)
  durationMinutes Int      @default(60)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items    InspectionChecklistItem[]
  bookings InspectionBooking[]

  @@unique([companyId, code])
}

model InspectionChecklistItem {
  id         String   @id @default(cuid())
  companyId  String
  serviceId  String?
  code       String
  labelEn    String
  labelAr    String
  category   String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service  InspectionService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  findings InspectionFinding[]

  @@index([companyId, serviceId])
}

model InspectionBooking {
  id            String                  @id @default(cuid())
  companyId     String
  bookingNumber String
  vehicleId     String
  customerId    String
  serviceId     String
  branchId      String?
  scheduledAt   DateTime
  status        InspectionBookingStatus @default(REQUESTED)
  inspectorUserId String?
  odometer      Int?
  notes         String?
  createdById   String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle  Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  service  InspectionService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  findings InspectionFinding[]
  report   InspectionReport?

  @@unique([companyId, bookingNumber])
  @@index([companyId, status])
  @@index([companyId, vehicleId])
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

model InspectionFinding {
  id           String          @id @default(cuid())
  companyId    String
  bookingId    String
  checklistItemId String?
  category     String
  severity     FindingSeverity @default(INFO)
  description  String
  isDefect     Boolean         @default(false)
  recommendation String?
  createdAt    DateTime        @default(now())

  company  Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  booking  InspectionBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  checklistItem InspectionChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)

  @@index([bookingId])
}

model InspectionReport {
  id            String                 @id @default(cuid())
  companyId     String
  bookingId     String                 @unique
  summary       String?
  overallCondition String?
  status        InspectionReportStatus @default(DRAFT)
  approvedById  String?
  approvedAt    DateTime?
  /** Sales invoice created from the inspection, when invoiced. */
  invoiceId     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  booking InspectionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

model WorkshopBay {
  id        String   @id @default(cuid())
  companyId String
  branchId  String?
  code      String
  nameEn    String
  nameAr    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

model MaintenanceBooking {
  id            String                   @id @default(cuid())
  companyId     String
  bookingNumber String
  vehicleId     String
  customerId    String
  branchId      String?
  bayId         String?
  scheduledAt   DateTime
  status        MaintenanceBookingStatus @default(REQUESTED)
  complaint     String?
  notes         String?
  createdById   String
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  jobCards JobCard[]

  @@unique([companyId, bookingNumber])
  @@index([companyId, status])
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

model JobCard {
  id            String        @id @default(cuid())
  companyId     String
  jobNumber     String
  vehicleId     String
  bookingId     String?
  customerId    String
  branchId      String?
  bayId         String?
  technicianUserId String?
  status        JobCardStatus @default(DRAFT)
  odometer      Int?
  complaint     String?
  diagnosis     String?
  startedAt     DateTime?
  completedAt   DateTime?
  /** Sales invoice raised for the completed job. */
  invoiceId     String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle   Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  booking   MaintenanceBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  labour        LabourOperation[]
  estimates     RepairEstimate[]
  reservations  PartsReservation[]
  warranties    WarrantyRecord[]

  @@unique([companyId, jobNumber])
  @@index([companyId, status])
  @@index([companyId, vehicleId])
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

model LabourOperation {
  id           String   @id @default(cuid())
  companyId    String
  jobCardId    String
  description  String
  /** Hours in hundredths of an hour (250 = 2.5 h). */
  hours        Int
  rateMinor    Int      @default(0)
  amountMinor  Int      @default(0)
  sortOrder    Int      @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobCard JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
}

model RepairEstimate {
  id            String        @id @default(cuid())
  companyId     String
  jobCardId     String
  estimateNumber String
  status        EstimateStatus @default(DRAFT)
  subtotalMinor Int           @default(0)
  taxMinor      Int           @default(0)
  totalMinor    Int           @default(0)
  currency      String        @default("SAR")
  customerApprovedById String?
  approvedAt    DateTime?
  expiresAt     DateTime?
  notes         String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobCard JobCard         @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  lines   RepairEstimateLine[]

  @@unique([companyId, estimateNumber])
  @@index([companyId, status])
}

model RepairEstimateLine {
  id             String           @id @default(cuid())
  companyId      String
  estimateId     String
  type           EstimateLineType @default(PART)
  productId      String?
  description    String
  quantity       Int
  unitPriceMinor Int
  taxPercentBp   Int              @default(0)
  lineTotalMinor Int
  sortOrder      Int              @default(0)

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimate RepairEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

/** Reservation of stock for a job card. Issuing it moves the shared stock ledger. */
model PartsReservation {
  id          String            @id @default(cuid())
  companyId   String
  jobCardId   String
  warehouseId String
  status      ReservationStatus @default(RESERVED)
  reservedAt  DateTime          @default(now())
  issuedAt    DateTime?
  createdById String

  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobCard JobCard               @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  lines   PartsReservationLine[]

  @@index([companyId, status])
  @@index([jobCardId])
}

model PartsReservationLine {
  id           String @id @default(cuid())
  companyId    String
  reservationId String
  productId    String
  /** Reserved quantity, scaled by 10^4. */
  quantity     Int
  issuedQuantity Int  @default(0)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reservation PartsReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([reservationId, productId])
  @@index([companyId])
}

/** OEM / aftermarket / cross-reference part numbers for a product. */
model PartReference {
  id         String        @id @default(cuid())
  companyId  String
  productId  String
  partNumber String
  type       PartNumberType @default(OEM)
  brand      String?
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, partNumber, type])
  @@index([companyId, productId])
}

/** Vehicle compatibility mapping for a product. */
model PartCompatibility {
  id        String   @id @default(cuid())
  companyId String
  productId String
  make      String
  model     String
  yearFrom  Int
  yearTo    Int?
  notes     String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId])
  @@index([companyId, make, model])
}

model WarrantyRecord {
  id         String   @id @default(cuid())
  companyId  String
  vehicleId  String
  jobCardId  String?
  description String
  terms      String?
  startsAt   DateTime @default(now())
  expiresAt  DateTime?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  jobCard JobCard? @relation(fields: [jobCardId], references: [id], onDelete: SetNull)

  @@index([companyId, vehicleId])
}

// ------------------------------------------------- marketplace foundations

model MarketplaceProvider {
  id                String         @id @default(cuid())
  code              String         @unique
  nameEn            String
  nameAr            String
  /** Set when the provider is itself an ORYX tenant company. */
  providerCompanyId String?
  categoryKey       String?
  email             String?
  phone             String?
  status            ProviderStatus @default(PENDING)
  /** Platform commission in basis points. */
  commissionPercentBp Int          @default(0)
  approvedAt        DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  listings     ProviderServiceListing[]
  requests     ServiceRequest[]
  commissions  MarketplaceCommission[]
  settlements  ProviderSettlement[]

  // Execution 04 — onboarding, portal, availability, reviews and disputes.
  applications    MarketplaceApplication[]
  providerUsers   ProviderUser[]
  availability    ProviderAvailability[]
  reviews         ProviderReview[]
  disputes        MarketplaceDispute[]
  bookingResources BookingResource[]

  @@index([status])
}

model ProviderServiceListing {
  id          String   @id @default(cuid())
  providerId  String
  categoryKey String
  nameEn      String
  nameAr      String
  description String?
  priceMinor  Int      @default(0)
  currency    String   @default("SAR")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider MarketplaceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([categoryKey])
}

model ServiceRequest {
  id            String               @id @default(cuid())
  companyId     String
  requestNumber String
  customerId    String?
  vehicleId     String?
  /** The consumer account that raised this request from the website or app. */
  customerAccountId String?
  categoryKey   String
  description   String?
  status        ServiceRequestStatus @default(NEW)
  providerId    String?
  assignedAt    DateTime?
  completedAt   DateTime?
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider MarketplaceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  commissions MarketplaceCommission[]
  reviews     ProviderReview[]
  disputes    MarketplaceDispute[]

  @@unique([companyId, requestNumber])
  @@index([companyId, status])
  @@index([customerAccountId])
}

model MarketplaceCommission {
  id               String           @id @default(cuid())
  companyId        String?
  serviceRequestId String?
  providerId       String
  baseMinor        Int
  rateBp           Int
  commissionMinor  Int
  currency         String           @default("SAR")
  status           CommissionStatus @default(PENDING)
  createdAt        DateTime         @default(now())

  company        Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider       MarketplaceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest?     @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  @@index([providerId, status])
}

model ProviderSettlement {
  id              String           @id @default(cuid())
  providerId      String
  periodStart     DateTime
  periodEnd       DateTime
  grossMinor      Int              @default(0)
  commissionMinor Int              @default(0)
  netMinor        Int              @default(0)
  currency        String           @default("SAR")
  status          SettlementStatus @default(DRAFT)
  approvedById    String?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  provider MarketplaceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, status])
}

// ============================================================================
// EXECUTION 04 — CUSTOMER PLATFORM, MARKETPLACE & MOBILE APPLICATIONS
//
// Three identity planes share one database:
//   1. Platform principals  (User + Membership)      — ERP / Super Admin
//   2. Provider principals  (User + ProviderUser)    — provider portal
//   3. Customer principals  (CustomerAccount)        — website + mobile app
//
// A CustomerAccount is a consumer identity. It is deliberately NOT a User:
// `User` carries tenant memberships and platform privileges, and conflating the
// two would let a consumer identity inherit an ERP scope. A consumer owns
// vehicles, addresses, bookings and payments through `CustomerAccount`, and the
// ERP sees those consumers as ordinary `Customer` rows inside a tenant.
// ============================================================================

// ---------------------------------------------------------------- E04 enums

enum CustomerAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

/** Which automotive workflow a booking slot belongs to. */
enum BookingType {
  INSPECTION
  MAINTENANCE
  PROVIDER_SERVICE
}

enum BookingStatus {
  /** Held while the customer completes checkout; released when it expires. */
  HELD
  CONFIRMED
  RESCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingResourceType {
  INSPECTOR
  BAY
  TECHNICIAN
  PROVIDER
}

enum ProviderApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PaymentIntentStatus {
  REQUIRES_METHOD
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentTransactionType {
  CHARGE
  AUTHORIZATION
  CAPTURE
  REFUND
  CHARGEBACK
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  VOIDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_PROVIDER
  RESOLVED
  ESCALATED
  CLOSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

/** Whether a delivery channel has working credentials or only an adapter. */
enum NotificationProviderState {
  /** Adapter implemented; no credentials configured. Nothing is transmitted. */
  NOT_CONFIGURED
  /** Credentials present; deliveries are attempted. */
  CONFIGURED
  /** Queued but not yet attempted. */
  PENDING
  /** The provider returned an error; retried until attempts are exhausted. */
  ERROR
  DISABLED
}

// ------------------------------------------------------ E04 customer identity

model CustomerAccount {
  id                 String                @id @default(cuid())
  email              String                @unique
  passwordHash       String
  fullName           String
  phone              String?
  status             CustomerAccountStatus @default(PENDING)
  preferredLocale    Locale                @default(ar)
  preferredTheme     Theme                 @default(dark)
  /** Set when the account is linked to a tenant customer record. */
  defaultCompanyId   String?
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  failedLoginCount   Int                   @default(0)
  lockedUntil        DateTime?
  /** Base32 TOTP secret, encrypted at rest; customers may opt in to MFA. */
  mfaEnabled         Boolean               @default(false)
  mfaSecretEncrypted String?
  mfaLastUsedStep    BigInt?
  mfaEnrolledAt      DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  defaultCompany Company? @relation(fields: [defaultCompanyId], references: [id], onDelete: SetNull)

  addresses       CustomerAddress[]
  privacy         CustomerPrivacySetting?
  preferences     CustomerNotificationPreference[]
  refreshTokens   CustomerRefreshToken[]
  resetTokens     CustomerPasswordResetToken[]
  /** Vehicles this consumer owns. Ownership is enforced server-side. */
  vehicles        Vehicle[]
  bookings        BookingSlot[]
  paymentIntents  PaymentIntent[]
  refunds         Refund[]
  reviews         ProviderReview[]
  disputes        MarketplaceDispute[]
  supportTickets  SupportTicket[]
  serviceRequests ServiceRequest[]
  notificationDeliveries NotificationDelivery[]

  @@index([status])
  @@index([defaultCompanyId])
}

model CustomerAddress {
  id           String   @id @default(cuid())
  accountId    String
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String
  area         String?
  countryCode  String   @default("BH")
  postalCode   String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/**
 * Account privacy controls. Every field defaults to the restrictive value so a
 * newly registered consumer is never silently opted in to data sharing.
 */
model CustomerPrivacySetting {
  id                       String    @id @default(cuid())
  accountId                String    @unique
  /** Allow providers to contact the customer directly about a booking. */
  shareContactWithProvider Boolean   @default(true)
  /** Include the vehicle in marketplace discovery / quote requests. */
  allowVehicleDiscovery    Boolean   @default(false)
  /** Marketing messages, separate from transactional messages. */
  allowMarketingEmails     Boolean   @default(false)
  allowMarketingSms        Boolean   @default(false)
  allowMarketingWhatsapp   Boolean   @default(false)
  /** Permit push notifications to this device set. */
  allowPushNotifications   Boolean   @default(false)
  /** Analytics/usage profiling. */
  allowAnalytics           Boolean   @default(false)
  /** Third-party data sharing beyond booking fulfilment. */
  allowThirdPartySharing   Boolean   @default(false)
  dataExportRequestedAt    DateTime?
  deletionRequestedAt      DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model CustomerNotificationPreference {
  id        String              @id @default(cuid())
  accountId String
  channel   NotificationChannel
  /** Category key, e.g. "booking", "invoice", "marketing", "support". */
  category  String
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt
  createdAt DateTime            @default(now())

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, channel, category])
  @@index([accountId])
}

model CustomerRefreshToken {
  id         String    @id @default(cuid())
  accountId  String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  familyId   String    @default(cuid())
  /** Distinguishes the web session from a mobile device session. */
  deviceKind String    @default("WEB")
  deviceName String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@index([familyId])
}

/**
 * Single-use password reset. Only the SHA-256 hash of the token is stored, so a
 * database read cannot be replayed into a reset.
 */
model CustomerPasswordResetToken {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

// --------------------------------------------------------- E04 booking engine

/**
 * A bookable resource: an inspector, a workshop bay, a technician or a
 * marketplace provider. Resources are what the scheduling engine allocates, so
 * inspections, workshop work and provider services share one calendar instead
 * of three divergent ones.
 */
model BookingResource {
  id           String              @id @default(cuid())
  companyId    String
  branchId     String?
  resourceType BookingResourceType
  code         String
  nameEn       String
  nameAr       String
  /** Optional link to the staff user who operates the resource. */
  userId       String?
  /** Optional link when the resource is a marketplace provider. */
  providerId   String?
  capacity     Int                 @default(1)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  provider MarketplaceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  workingHours WorkingHours[]
  exceptions   BookingResourceException[]
  slots        BookingSlot[]

  @@unique([companyId, code])
  @@index([companyId, resourceType])
  @@index([companyId, branchId])
}

/** Recurring weekly opening hours for a resource (or a branch when resourceId is null). */
model WorkingHours {
  id           String   @id @default(cuid())
  companyId    String
  branchId     String?
  resourceId   String?
  /** 0 = Sunday … 6 = Saturday, matching the Gulf working week. */
  dayOfWeek    Int
  /** Minutes from midnight, local to the branch timezone. */
  opensMinute  Int
  closesMinute Int
  isClosed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  resource BookingResource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([companyId, dayOfWeek])
  @@index([resourceId])
}

/** A dated exception: a holiday, a training day or an extended shift. */
model BookingResourceException {
  id           String   @id @default(cuid())
  companyId    String
  resourceId   String
  date         DateTime
  isClosed     Boolean  @default(true)
  opensMinute  Int?
  closesMinute Int?
  reason       String?
  createdAt    DateTime @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resource BookingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, date])
  @@index([companyId, date])
}

/**
 * The central scheduling reservation.
 *
 * Double-booking is prevented by a **partial unique index** on
 * `(resourceKey, startsAt)` restricted to rows whose status is not CANCELLED
 * (see the migration). That constraint lives in PostgreSQL, so two concurrent
 * requests that both pass the availability pre-check still cannot both commit —
 * the loser receives a unique violation and the API answers HTTP 409. The
 * pre-check alone would be a race and is deliberately not relied upon.
 *
 * `resourceKey` is derived by the service: the resource id when one is chosen,
 * otherwise a deterministic key (`branch:<id>|service:<ref>`) so resource-less
 * bookings are serialised against each other too.
 */
model BookingSlot {
  id                 String        @id @default(cuid())
  companyId          String
  branchId           String?
  resourceId         String?
  /** Non-null. See the model comment: this is the concurrency key. */
  resourceKey        String
  bookingType        BookingType
  status             BookingStatus @default(HELD)
  /** Service catalog id (inspection service, provider listing, …). */
  serviceRef         String?
  startsAt           DateTime
  endsAt             DateTime
  /** Whole minutes; a snapshot so later catalog edits do not move history. */
  durationMinutes    Int
  customerAccountId  String?
  customerId         String?
  vehicleId          String?
  /** The module document this slot schedules (InspectionBooking, JobCard, …). */
  entityType         String?
  entityId           String?
  /** Populated while status is HELD; an expired hold is released and reusable. */
  holdExpiresAt      DateTime?
  reference          String
  notes              String?
  cancellationReason String?
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  resource        BookingResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  events BookingEvent[]

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([companyId, startsAt])
  @@index([resourceKey, startsAt])
  @@index([customerAccountId, startsAt])
  @@index([entityType, entityId])
}

/** Append-only booking lifecycle log; also drives reminders and delivery. */
model BookingEvent {
  id         String         @id @default(cuid())
  companyId  String
  slotId     String
  kind       String
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  message    String?
  actorKind  String         @default("SYSTEM")
  actorId    String?
  createdAt  DateTime       @default(now())

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slot    BookingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([slotId, createdAt])
  @@index([companyId, kind])
}

// ------------------------------------------------- E04 marketplace lifecycle

/** A provider's onboarding application, reviewed before any listing is live. */
model MarketplaceApplication {
  id                 String                    @id @default(cuid())
  code               String                    @unique
  legalNameEn        String
  legalNameAr        String
  contactEmail       String
  contactPhone       String
  /** Commercial registration / CR number supplied by the applicant. */
  registrationNumber String?
  taxNumber          String?
  countryCode        String                    @default("BH")
  city               String?
  addressLine        String?
  categoryKeys       String[]                  @default([])
  status             ProviderApplicationStatus @default(SUBMITTED)
  submittedAt        DateTime                  @default(now())
  reviewedAt         DateTime?
  reviewedById       String?
  reviewNote         String?
  /** Set when the application is approved and a provider record is created. */
  providerId         String?                   @unique
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  provider MarketplaceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([contactEmail])
}

/** Links a platform user to the provider it may administer. */
model ProviderUser {
  id         String   @id @default(cuid())
  providerId String
  userId     String
  role       String   @default("OWNER")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider MarketplaceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, userId])
  @@index([userId])
}

/** Provider-declared availability, merged with the shared booking engine. */
model ProviderAvailability {
  id                   String   @id @default(cuid())
  providerId           String
  dayOfWeek            Int
  opensMinute          Int
  closesMinute         Int
  isClosed             Boolean  @default(false)
  /** Lead time before a slot may be booked, in minutes. */
  minimumNoticeMinutes Int      @default(60)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  provider MarketplaceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek])
  @@index([providerId])
}

/** A customer review of a completed provider service. */
model ProviderReview {
  id                String       @id @default(cuid())
  providerId        String
  serviceRequestId  String?
  bookingSlotId     String?
  customerAccountId String
  /** 1–5. Enforced in the service layer as well as the database. */
  rating            Int
  title             String?
  comment           String?
  status            ReviewStatus @default(PENDING)
  /** Set when a provider replies to the review. */
  providerReply     String?
  providerRepliedAt DateTime?
  publishedAt       DateTime?
  moderatedById     String?
  moderationNote    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  provider        MarketplaceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceRequest  ServiceRequest?     @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  customerAccount CustomerAccount     @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@unique([customerAccountId, serviceRequestId])
  @@index([providerId, status])
}

/** A customer complaint against a provider, with a resolution trail. */
model MarketplaceDispute {
  id                String          @id @default(cuid())
  code              String          @unique
  providerId        String
  serviceRequestId  String?
  bookingSlotId     String?
  customerAccountId String
  subject           String
  description       String
  status            DisputeStatus   @default(OPEN)
  resolution        String?
  /** Amount refunded or credited as a result of the dispute, in minor units. */
  compensationMinor Int             @default(0)
  resolvedAt        DateTime?
  resolvedById      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  provider        MarketplaceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceRequest  ServiceRequest?     @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  customerAccount CustomerAccount     @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  messages DisputeMessage[]

  @@index([status])
  @@index([providerId, status])
  @@index([customerAccountId])
}

model DisputeMessage {
  id         String   @id @default(cuid())
  disputeId  String
  /** CUSTOMER | PROVIDER | PLATFORM */
  authorKind String
  authorId   String?
  body       String
  /** Internal notes are never shown to the customer. */
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  dispute MarketplaceDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
}

// ---------------------------------------------------------------- E04 payments

/**
 * A payment attempt against a document (invoice, booking, settlement).
 *
 * The intent records what the customer is trying to pay; `PaymentTransaction`
 * records what the provider actually reported. Nothing is ever marked paid from
 * a client response: only a verified transaction or webhook may settle a
 * document. Idempotency keys are unique per company, so a retried request
 * returns the original intent rather than charging twice.
 */
model PaymentIntent {
  id                String             @id @default(cuid())
  companyId         String
  branchId          String?
  intentNumber      String
  customerId        String?
  customerAccountId String?
  /** What is being paid: SALES_INVOICE | BOOKING | SERVICE_REQUEST | SETTLEMENT. */
  targetType        String
  targetId          String
  amountMinor       Int
  currency          String             @default("BHD")
  /** 3 for BHD/KWD/OMR, 2 for most others. Stored so totals are unambiguous. */
  currencyScale     Int                @default(3)
  status            PaymentIntentStatus @default(REQUIRES_METHOD)
  /** Adapter key: CASH | CARD_TERMINAL | BANK_TRANSFER | BENEFITPAY | MANUAL. */
  provider          String             @default("MANUAL")
  providerReference String?
  idempotencyKey    String
  description       String?
  expiresAt         DateTime?
  succeededAt       DateTime?
  failedReason      String?
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  transactions PaymentTransaction[]
  refunds      Refund[]

  @@unique([companyId, intentNumber])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, status])
  @@index([targetType, targetId])
  @@index([customerAccountId])
}

model PaymentTransaction {
  id                String                   @id @default(cuid())
  companyId         String
  intentId          String?
  transactionType   PaymentTransactionType
  status            PaymentTransactionStatus @default(PENDING)
  amountMinor       Int
  currency          String                   @default("BHD")
  currencyScale     Int                      @default(3)
  provider          String
  /** The provider's own transaction id. Unique per provider when present. */
  providerReference String?
  /** Opaque gateway payload retained for reconciliation and dispute evidence. */
  rawPayload        Json?
  failureReason     String?
  processedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  intent  PaymentIntent? @relation(fields: [intentId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([provider, providerReference])
  @@index([intentId])
}

model Refund {
  id                String       @id @default(cuid())
  companyId         String
  intentId          String
  customerAccountId String?
  refundNumber      String
  amountMinor       Int
  currency          String       @default("BHD")
  currencyScale     Int          @default(3)
  reason            String
  status            RefundStatus @default(REQUESTED)
  /** Set when the reversal is written to the ledger. */
  journalEntryId    String?
  /** The gateway refund reference once the provider confirms it. */
  providerReference String?
  requestedById     String?
  approvedById      String?
  processedAt       DateTime?
  failureReason     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  intent          PaymentIntent    @relation(fields: [intentId], references: [id], onDelete: Restrict)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  @@unique([companyId, refundNumber])
  @@index([companyId, status])
  @@index([intentId])
}

/**
 * Inbound webhook ledger.
 *
 * `(provider, eventId)` is unique, which is what makes webhook handling
 * idempotent: a redelivered event is recognised and acknowledged without being
 * applied a second time. The signature is verified before the row is written.
 */
model PaymentWebhookEvent {
  id             String    @id @default(cuid())
  provider       String
  eventId        String
  eventType      String
  signatureValid Boolean   @default(false)
  /** Raw body hash, retained so a payload cannot be silently swapped. */
  payloadHash    String
  payload        Json?
  processedAt    DateTime?
  processResult  String?
  attempts       Int       @default(0)
  error          String?
  createdAt      DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventType])
  @@index([processedAt])
}

/** A daily reconciliation run against a provider's settlement report. */
model PaymentReconciliation {
  id            String   @id @default(cuid())
  companyId     String
  provider      String
  businessDate  DateTime
  /** Totals computed from our own transaction table. */
  internalCount Int      @default(0)
  internalMinor Int      @default(0)
  /** Totals reported by the provider. */
  externalCount Int      @default(0)
  externalMinor Int      @default(0)
  /** internalMinor − externalMinor. Non-zero means a break to investigate. */
  varianceMinor Int      @default(0)
  matched       Boolean  @default(false)
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider, businessDate])
  @@index([companyId, matched])
}

// ------------------------------------------------------------ E04 notifications

/**
 * One delivery attempt per channel for one logical notification.
 *
 * The in-app channel is genuinely functional (the row is the message). Email,
 * SMS, WhatsApp and push rows record what an adapter did: when a channel has no
 * credentials the row is SKIPPED with `providerState = NOT_CONFIGURED`, so the
 * platform never claims a message was delivered when nothing was transmitted.
 */
model NotificationDelivery {
  id                String                     @id @default(cuid())
  companyId         String?
  customerAccountId String?
  userId            String?
  channel           NotificationChannel
  category          String                     @default("general")
  templateKey       String?
  locale            Locale                     @default(ar)
  recipient         String?
  subject           String?
  body              String
  status            NotificationDeliveryStatus @default(QUEUED)
  providerState     NotificationProviderState  @default(NOT_CONFIGURED)
  provider          String?
  providerReference String?
  attempts          Int                        @default(0)
  maxAttempts       Int                        @default(3)
  nextAttemptAt     DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  error             String?
  /** Correlates a delivery with the document that produced it. */
  entityType        String?
  entityId          String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([customerAccountId, createdAt])
  @@index([companyId, category])
}

// ============================================================================
// EXECUTION 05 — EXTERNAL INTEGRATIONS CENTER & PLATFORM COMPLETION
//
// Provider definitions live in @oryx/shared (INTEGRATION_PROVIDERS) so the
// admin UI, the API and the tests cannot drift. The tables here hold only the
// per-deployment and per-tenant *state*: which credentials are stored, whether
// the provider is enabled, and the outcome of the last verification attempt.
//
// Secrets are never stored in plaintext: `IntegrationCredential.value` holds the
// AES-256-GCM sealed value produced by SecretCipher, and every read path masks
// it. The audit trail records that a credential changed, never its contents.
// ============================================================================

/** Whether a provider is switched on for the deployment or for one tenant. */
enum IntegrationScope {
  PLATFORM
  COMPANY
}

/** The last known verification outcome. Only VERIFIED means "working". */
enum IntegrationVerificationStatus {
  /** Never tested since the credentials were last changed. */
  UNVERIFIED
  /** A real call reached the provider and it answered successfully. */
  VERIFIED
  /** A real call was attempted and the provider rejected or failed it. */
  FAILED
  /** Credentials are incomplete; no call could be made. */
  INCOMPLETE
}

model IntegrationProvider {
  id               String           @id @default(cuid())
  /** Provider key from @oryx/shared, e.g. BENEFITPAY. */
  providerKey      String
  scope            IntegrationScope @default(PLATFORM)
  /** Set only when scope is COMPANY. */
  companyId        String?
  enabled          Boolean          @default(false)
  /** Operator note explaining why it is disabled, if it is. */
  disabledReason   String?
  verificationStatus IntegrationVerificationStatus @default(UNVERIFIED)
  lastCheckedAt    DateTime?
  lastCheckMessage String?
  /** Who last changed the configuration, for accountability. */
  updatedById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company     Company?                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  credentials IntegrationCredential[]
  checks      IntegrationCheck[]

  @@unique([providerKey, scope, companyId])
  @@index([scope, companyId])
}

model IntegrationCredential {
  id            String   @id @default(cuid())
  providerId    String
  /** Credential key from the provider definition, e.g. BENEFITPAY_API_KEY. */
  credentialKey String
  /** AES-256-GCM sealed value. Never returned to a client unmasked. */
  value         String
  /** Last four characters, kept so an operator can tell two keys apart. */
  hint          String?
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, credentialKey])
  @@index([providerId])
}

/** Append-only record of every connection test, successful or not. */
model IntegrationCheck {
  id          String                        @id @default(cuid())
  providerId  String
  status      IntegrationVerificationStatus
  /** Human-readable outcome, safe to display. Never contains a secret. */
  message     String
  /** How long the probe took, so a hanging provider is visible. */
  durationMs  Int?
  actorUserId String?
  createdAt   DateTime                      @default(now())

  provider IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
}
