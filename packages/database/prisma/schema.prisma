// ORYX — Execution 01 data model.
//
// Hierarchy: Platform -> Company (internal group company OR external SaaS
// tenant) -> Branch. Tenant-owned rows always carry `companyId` so that
// isolation can be enforced in queries, never only in the UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum CompanyType {
  INTERNAL
  SAAS_TENANT
}

enum CompanyStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

enum ModuleStatus {
  AVAILABLE
  PLANNED
}

enum Locale {
  ar
  en
}

enum Theme {
  dark
  light
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CmsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MobilePlatform {
  IOS
  ANDROID
}

enum SupportSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

// ---------------------------------------------------------------- identity

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  fullNameEn     String
  fullNameAr     String
  status         UserStatus @default(INVITED)
  isSuperAdmin   Boolean    @default(false)
  preferredLocale Locale    @default(ar)
  preferredTheme Theme      @default(dark)
  lastLoginAt    DateTime?
  failedLoginCount Int      @default(0)
  lockedUntil    DateTime?
  /** TOTP MFA: secret is stored encrypted at rest, never in plaintext. */
  mfaEnabled     Boolean    @default(false)
  mfaSecretEncrypted String?
  /** Short-lived, single-use enrollment secret pending verification. */
  mfaPendingSecretEncrypted String?
  mfaPendingExpiresAt DateTime?
  /** Monotonic counter that rejects replay of an already-accepted TOTP step. */
  mfaLastUsedStep BigInt?
  mfaEnrolledAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  memberships       Membership[]
  refreshTokens     RefreshToken[]
  invitationsSent   Invitation[]     @relation("InvitationInviter")
  auditLogs         AuditLog[]
  supportSessions   SupportSession[] @relation("SupportSessionActor")
  mfaRecoveryCodes  MfaRecoveryCode[]

  @@index([status])
}

/**
 * Single-use MFA recovery codes. Only a hash of each code is stored, and a
 * code is marked used the first time it is redeemed.
 */
model MfaRecoveryCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- organization

model Company {
  id              String        @id @default(cuid())
  code            String        @unique
  nameEn          String
  nameAr          String
  legalNameEn     String?
  type            CompanyType
  status          CompanyStatus @default(PROVISIONING)
  industry        String?
  countryCode     String?
  currency        String        @default("SAR")
  timezone        String        @default("Asia/Riyadh")
  taxNumber       String?
  parentCompanyId String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  parent       Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  children     Company[] @relation("CompanyHierarchy")
  branches     Branch[]
  memberships  Membership[]
  roles        Role[]
  subscriptions Subscription[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  supportSessions SupportSession[]

  @@index([type])
  @@index([status])
  @@index([parentCompanyId])
}

model Branch {
  id          String   @id @default(cuid())
  companyId   String
  code        String
  nameEn      String
  nameAr      String
  city        String?
  countryCode String?
  addressLine String?
  phone       String?
  timezone    String   @default("Asia/Riyadh")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships MembershipBranch[]

  @@unique([companyId, code])
  @@index([companyId])
}

// ---------------------------------------------------------------- RBAC

model Role {
  id            String   @id @default(cuid())
  companyId     String?
  code          String
  nameEn        String
  nameAr        String
  descriptionEn String?
  isSystem      Boolean  @default(false)
  /** Platform roles are not editable by company admins. */
  isPlatform    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]

  @@unique([companyId, code])
  @@index([companyId])
}

model RolePermission {
  id             String @id @default(cuid())
  roleId         String
  permissionCode String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionCode])
  @@index([roleId])
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  companyId  String
  roleId     String
  isActive   Boolean  @default(true)
  invitedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branches MembershipBranch[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model MembershipBranch {
  id           String @id @default(cuid())
  membershipId String
  branchId     String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([membershipId, branchId])
  @@index([branchId])
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  companyId   String
  roleId      String
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy User?            @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  branches  InvitationBranch[]

  @@index([companyId])
  @@index([email])
}

model InvitationBranch {
  id           String @id @default(cuid())
  invitationId String
  branchId     String

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, branchId])
}

// ---------------------------------------------------------------- modules / plans

model Module {
  id             String       @id @default(cuid())
  key            String       @unique
  nameEn         String
  nameAr         String
  descriptionEn  String
  descriptionAr  String
  group          String
  icon           String
  route          String
  status         ModuleStatus @default(PLANNED)
  deliveryPhase  String
  readPermission String
  writePermission String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  planModules PlanModule[]

  @@index([group])
}

model Plan {
  id                 String   @id @default(cuid())
  code               String   @unique
  nameEn             String
  nameAr             String
  descriptionEn      String
  descriptionAr      String
  monthlyPrice       Decimal  @db.Decimal(12, 2)
  annualPrice        Decimal  @db.Decimal(12, 2)
  currency           String   @default("SAR")
  isPublic           Boolean  @default(true)
  isActive           Boolean  @default(true)
  trialDays          Int      @default(14)
  /** -1 means unlimited. */
  maxCompanies       Int      @default(1)
  maxBranches        Int      @default(1)
  maxUsers           Int      @default(5)
  storageMb          Int      @default(1024)
  apiRequestsPerMonth Int     @default(10000)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  modules       PlanModule[]
  subscriptions Subscription[]

  @@index([isActive])
}

model PlanModule {
  id        String @id @default(cuid())
  planId    String
  moduleKey String

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  @@unique([planId, moduleKey])
}

model Subscription {
  id               String             @id @default(cuid())
  companyId        String
  planId           String
  status           SubscriptionStatus @default(TRIAL)
  billingPeriod    BillingPeriod      @default(MONTHLY)
  price            Decimal            @db.Decimal(12, 2)
  currency         String             @default("SAR")
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  /** Denormalised snapshot of the licensed module keys at activation. */
  licensedModules  String[]           @default([])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  events  SubscriptionEvent[]

  @@index([companyId])
  @@index([status])
}

model SubscriptionEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  type           String
  fromStatus     String?
  toStatus       String?
  fromPlanId     String?
  toPlanId       String?
  amount         Decimal? @db.Decimal(12, 2)
  currency       String?
  note           String?
  actorUserId    String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// ---------------------------------------------------------------- governance

model SupportSession {
  id        String               @id @default(cuid())
  actorUserId String
  companyId String
  reason    String
  status    SupportSessionStatus @default(ACTIVE)
  expiresAt DateTime
  endedAt   DateTime?
  createdAt DateTime             @default(now())

  actor   User    @relation("SupportSessionActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([actorUserId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  companyId   String?
  action      String
  targetType  String
  targetId    String?
  summary     String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
}

// ---------------------------------------------------------------- website & app CMS

model CmsPage {
  id          String    @id @default(cuid())
  slug        String
  locale      Locale
  title       String
  excerpt     String?
  body        String
  status      CmsStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([slug, locale])
}

model CmsBanner {
  id        String  @id @default(cuid())
  placement String
  locale    Locale
  title     String
  subtitle  String?
  imageUrl  String?
  actionUrl String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, locale])
}

model FeatureFlag {
  id                String   @id @default(cuid())
  key               String   @unique
  nameEn            String
  nameAr            String
  description       String?
  enabled           Boolean  @default(false)
  audience          String   @default("all")
  rolloutPercentage Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AppVersion {
  id                  String         @id @default(cuid())
  platform            MobilePlatform
  version             String
  buildNumber         String
  releaseNotes        String?
  minSupportedVersion String
  isActive            Boolean        @default(false)
  releasedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([platform, version])
}

model ApiClient {
  id                String    @id @default(cuid())
  name              String
  clientId          String    @unique
  secretHash        String
  scopes            String[]  @default([])
  isActive          Boolean   @default(true)
  rateLimitPerMinute Int      @default(60)
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ServiceCategory {
  id         String   @id @default(cuid())
  key        String   @unique
  nameEn     String
  nameAr     String
  domain     String
  icon       String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  key       String
  channel   String
  locale    Locale
  subject   String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
