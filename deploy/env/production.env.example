# ORYX — production environment template.
#
# Copy to `.env.production` at the repository root and fill in every value
# marked `CHANGE_ME`. `.env.production` is git-ignored; never commit it.
#
#   cp deploy/env/production.env.example .env.production
#   # edit .env.production
#   docker compose -f deploy/docker-compose.production.yml --env-file .env.production up -d --build
#
# Generate the secrets with:
#   openssl rand -base64 48
#
# See docs/DEPLOYMENT.md for the runbook and §9 for the pre-launch checklist.

# ============================================================================
# Compose / infrastructure
# ============================================================================
# Public hostnames. Each must have a matching certificate pair in
# deploy/nginx/certs/ named <host>.crt, <host>.key and <host>.chain.crt.
ORYX_ADMIN_HOST=admin.CHANGE_ME
ORYX_CUSTOMER_HOST=www.CHANGE_ME
ORYX_IMAGE_TAG=2026.10.18
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# Which env file the API *container* reads, relative to deploy/. Leave this
# unset for production: it then defaults to ../.env.production. A staging stack
# sets it to its own file (../.env.staging), otherwise `--env-file .env.staging`
# would still leave the API container holding every production secret, because
# --env-file only interpolates ${...} in the compose file and does not override
# a service's `env_file:`. Verify with deploy/scripts/verify-staging-isolation.sh.
# ORYX_API_ENV_FILE=../.env.staging

# ============================================================================
# Database
# ============================================================================
POSTGRES_USER=oryx
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password
POSTGRES_DB=oryx_production
# Inside the compose network the host is the service name `postgres`.
# `?connection_limit=` is deliberate: one API replica should not open more
# connections than the database can serve.
DATABASE_URL=postgresql://oryx:CHANGE_ME_strong_database_password@postgres:5432/oryx_production?schema=public&connection_limit=10

# ============================================================================
# API — required
# ============================================================================
API_PORT=3001
API_PREFIX=api
# The public origin(s) the browser will use. Must match the hostnames above,
# scheme included, comma-separated, no trailing slash.
CORS_ORIGINS=https://admin.CHANGE_ME,https://www.CHANGE_ME

# Session signing. Each must be at least 32 characters and different from each
# other. Rotating either invalidates every existing session.
JWT_ACCESS_SECRET=CHANGE_ME_min_32_characters_long_random
JWT_REFRESH_SECRET=CHANGE_ME_min_32_characters_long_random_different
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# AES-256-GCM key for TOTP secrets. Rotating it invalidates every enrolled
# second factor; users must re-enrol.
MFA_ENCRYPTION_KEY=CHANGE_ME_min_32_characters_long_random
MFA_ISSUER=ORYX Platform
MFA_CHALLENGE_TTL=300
# Must be true in production. An unenrolled Super Admin is a single-factor
# administrator of the whole platform.
MFA_REQUIRE_SUPER_ADMIN=true

# ============================================================================
# Cookies and CSRF
# ============================================================================
# `lax` is correct when the API is same-origin through the proxy. Use `none`
# only if you deliberately host the API on a separate origin, which also
# requires `Secure` and a wider CORS origin list.
COOKIE_SAMESITE=lax
REFRESH_ROTATION_GRACE_MS=30000

# ============================================================================
# Throttling
# ============================================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
REFRESH_THROTTLE_LIMIT=120
INVITATION_THROTTLE_LIMIT=20

# ============================================================================
# Uploads
# ============================================================================
# Baked into the API image as /data/media and backed by the `media-data` volume.
MEDIA_ROOT=/data/media

# ============================================================================
# Front-end build arguments
# ============================================================================
# Baked into the Next.js bundles at build time, so changing them needs a rebuild
# (`up -d --build`), not just a restart.
NEXT_PUBLIC_API_BASE_URL=https://www.CHANGE_ME/api
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_DEFAULT_THEME=light

# ============================================================================
# Integrations — leave blank until a real vendor contract exists
# ============================================================================
# A blank value is honest: the provider reports itself unconfigured and the
# customer capabilities endpoint does not advertise it. Do not invent values.
BENEFITPAY_MERCHANT_ID=
BENEFITPAY_API_KEY=
BENEFITPAY_API_SECRET=
BENEFITPAY_BASE_URL=
BENEFITPAY_WEBHOOK_SECRET=
CARD_GATEWAY_PROVIDER=
CARD_GATEWAY_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
SMTP_HOST=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
PUSH_PROVIDER=
PUSH_SERVER_KEY=

# ============================================================================
# Backups
# ============================================================================
# Where `deploy/scripts/backup.sh` writes on the host. Mounted into the
# postgres container as /backups.
ORYX_BACKUP_DIR=./backups
# Days of daily backups to keep before the oldest are pruned.
ORYX_BACKUP_RETENTION_DAYS=30
