# ORYX — Admin (control plane) runtime image.
#
# Next.js is built in "standalone" mode so the runtime image carries a minimal
# server plus the traced dependency subset, instead of the whole workspace.
#
# Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.admin \
#     --build-arg NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api \
#     -t oryx-admin .

# ---------------------------------------------------------------- base
FROM node:20-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV CI=true
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

FROM base AS manifest
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/shared/package.json        packages/shared/
COPY packages/database/package.json      packages/database/
COPY apps/api/package.json               apps/api/
COPY apps/admin/package.json             apps/admin/
COPY apps/customer/package.json          apps/customer/
COPY apps/mobile/package.json            apps/mobile/
RUN pnpm install --frozen-lockfile --prod=false

# ----------------------------------------------------------------- build
FROM manifest AS build
# Baked into the client bundle by Next.js at build time. It must therefore be
# supplied as a build argument, not only as a runtime environment variable.
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_DEFAULT_LOCALE=ar
ARG NEXT_PUBLIC_DEFAULT_THEME=light
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_DEFAULT_LOCALE=$NEXT_PUBLIC_DEFAULT_LOCALE
ENV NEXT_PUBLIC_DEFAULT_THEME=$NEXT_PUBLIC_DEFAULT_THEME
ENV ORYX_DOCKER_BUILD=1
ENV NEXT_TELEMETRY_DISABLED=1

COPY packages ./packages
COPY apps/admin ./apps/admin
RUN pnpm --filter @oryx/shared build \
 && pnpm --filter @oryx/admin build

# --------------------------------------------------------------- runtime
FROM base AS runtime
ENV NODE_ENV=production
ENV PORT=3000
# Next.js standalone binds to `process.env.HOSTNAME`, which Docker sets to the
# container id. That id resolves on the compose network but not on loopback, so
# the healthcheck below would fail while the app served traffic normally. Bind
# every interface explicitly.
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

RUN groupadd --system --gid 1001 oryx \
 && useradd --system --uid 1001 --gid oryx --create-home --shell /usr/sbin/nologin oryx

COPY --from=build /app/apps/admin/.next/standalone ./
COPY --from=build /app/apps/admin/.next/static     ./apps/admin/.next/static
COPY --from=build /app/apps/admin/public           ./apps/admin/public

USER oryx
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/admin/server.js"]
