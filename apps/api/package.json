{
  "name": "@oryx/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -f tsconfig.build.tsbuildinfo dist/tsconfig.build.tsbuildinfo && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"api: lint not configured\" && exit 0",
    "test": "jest --config jest.config.js --runInBand",
    "test:e2e": "jest --config jest-e2e.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.2.1",
    "@nestjs/throttler": "6.4.0",
    "@oryx/database": "workspace:*",
    "@oryx/shared": "workspace:*",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.8",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "jest": "30.2.0",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
