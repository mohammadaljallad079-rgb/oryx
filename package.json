{
  "name": "oryx",
  "version": "0.1.0",
  "private": true,
  "description": "ORYX — Holding ERP, Business SaaS ERP and Automotive Ecosystem (Execution 01 foundation)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:generate": "pnpm --filter @oryx/database generate",
    "db:migrate": "pnpm --filter @oryx/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @oryx/database migrate:dev",
    "db:seed": "pnpm --filter @oryx/database seed",
    "db:reset": "pnpm --filter @oryx/database reset",
    "provision:super-admin": "node scripts/provision-super-admin.mjs",
    "build": "pnpm -r --filter @oryx/shared build && pnpm --filter @oryx/database build && pnpm --filter @oryx/api build && pnpm --filter @oryx/admin build && pnpm --filter @oryx/customer build",
    "dev:api": "pnpm --filter @oryx/api dev",
    "dev:admin": "pnpm --filter @oryx/admin dev",
    "dev:customer": "pnpm --filter @oryx/customer dev",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @oryx/api test",
    "test:shared": "pnpm --filter @oryx/shared test",
    "test:e2e": "pnpm --filter @oryx/api test:e2e",
    "test:ui": "pnpm --filter @oryx/admin test:ui",
    "build:site": "ORYX_STATIC_EXPORT=1 pnpm --filter @oryx/shared build && ORYX_STATIC_EXPORT=1 pnpm --filter @oryx/database build && ORYX_STATIC_EXPORT=1 pnpm --filter @oryx/customer build",
    "preview:build": "node scripts/preview/build-preview.mjs",
    "preview:serve": "node scripts/preview/serve-preview.mjs",
    "preview:verify": "node scripts/preview/verify-preview.mjs",
    "preview:check": "node scripts/preview/check-links.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    }
  }
}
